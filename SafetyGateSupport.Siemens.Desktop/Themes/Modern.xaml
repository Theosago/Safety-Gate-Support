  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- Siemens column input switches: ON/OFF toggles (kept as the implicit ToggleButton look). -->
 <Style TargetType="ToggleButton"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource ThemeForeground405D70}"/><Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Switch" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><StackPanel><ContentPresenter HorizontalAlignment="Center"/><TextBlock x:Name="Value" Text="OFF" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Switch" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter TargetName="Value" Property="Text" Value="ON"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Switch" Property="BorderBrush" Value="{DynamicResource FocusRing}"/><Setter TargetName="Switch" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Switch" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
