<Window x:Class="SiemensUsbCheck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Signal column configuration"
        Width="1100" Height="900" MinWidth="720" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="StepBadge" TargetType="Border"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,0,14,0"/></Style>
        <Style x:Key="StepBadgeText" TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="StepTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource InkMuted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="13"/></Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,20,24,24">
        <!-- Header -->
        <TextBlock x:Name="ContextText" Style="{StaticResource Muted}" FontWeight="SemiBold" Visibility="Collapsed"/>
        <TextBlock Text="Signal column" FontSize="25" FontWeight="SemiBold" Margin="0,2,0,0"/>
        <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,16" Text="Load this unit’s saved configuration onto a new or replacement column."/>

        <!-- Three steps -->
        <Border Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
                <DockPanel>
                    <Border Style="{StaticResource StepBadge}"><TextBlock Text="1" Style="{StaticResource StepBadgeText}"/></Border>
                    <StackPanel>
                        <TextBlock Text="Connect the column" Style="{StaticResource StepTitle}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="Close the Siemens configurator, then plug the column into this PC with a USB-C data cable."/>
                        <DockPanel Margin="0,8,0,0">
                            <Button x:Name="RefreshButton" Content="Look again" Style="{StaticResource QuietButton}" DockPanel.Dock="Right" Click="RefreshButton_Click" Margin="8,-4,0,-4"/>
                            <TextBlock x:Name="DetectionText" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Text="Looking for a connected column…"/>
                        </DockPanel>
                        <ComboBox x:Name="DeviceCombo" IsEditable="False" Margin="0,8,0,0" MaxWidth="460" HorizontalAlignment="Left" MinWidth="320" Visibility="Collapsed"
                                  SelectionChanged="DeviceCombo_SelectionChanged" AutomationProperties.Name="Connected column"/>
                    </StackPanel>
                </DockPanel>

                <Separator Margin="42,16,0,16"/>

                <DockPanel>
                    <Border Style="{StaticResource StepBadge}"><TextBlock Text="2" Style="{StaticResource StepBadgeText}"/></Border>
                    <StackPanel>
                        <TextBlock Text="Choose the configuration on file" Style="{StaticResource StepTitle}"/>
                        <ComboBox x:Name="AssignedFilesCombo" DisplayMemberPath="Label" SelectionChanged="AssignedFiles_SelectionChanged" Margin="0,8,0,0" MaxWidth="560" HorizontalAlignment="Left" MinWidth="320" Visibility="Collapsed" AutomationProperties.Name="Configuration on file"/>
                        <TextBlock x:Name="SelectedSignalText" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" Text="Choose a configuration file under More options."/>
                        <WrapPanel Margin="-4,8,0,0">
                            <Button x:Name="ReadButton" Content="Compare with the column" IsEnabled="False" Click="ReadButton_Click" ToolTip="Reads the column’s stored settings (a backup is saved) and compares them with this file"/>
                            <TextBlock x:Name="MatchText" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>

                <Separator Margin="42,16,0,16"/>

                <DockPanel>
                    <Border Style="{StaticResource StepBadge}"><TextBlock Text="3" Style="{StaticResource StepBadgeText}"/></Border>
                    <StackPanel>
                        <TextBlock Text="Upload to the column" Style="{StaticResource StepTitle}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="The column’s current settings are backed up first, and the upload is checked afterwards. Then check the lights and sound."/>
                        <WrapPanel Margin="-4,10,0,0">
                            <Button x:Name="UploadButton" Content="Upload to column" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="UploadButton_Click" MinHeight="44" Padding="22,8"/>
                            <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Visibility="Collapsed" Click="CancelButton_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Ready. Looking for a column does not open USB."/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- What the configuration shows, and its paired PDF -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="18,14" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="What this configuration shows" FontSize="16" FontWeight="SemiBold"/>
                    <TabControl x:Name="WorkflowTabs" Padding="0,10,0,0">
                        <TabItem Header="All states">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" Text="Each row is an input combination and the segments it lights (segment 1 first). Click a row to look at it closely."/>
                                <StackPanel x:Name="StateTablePanel"/>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Try inputs">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="Switch inputs on to see the result. These switches only change this preview."/>
                                <WrapPanel Margin="0,8">
                                    <ToggleButton x:Name="Input1Toggle" Tag="1" Content="Input 1" Checked="Input_Changed" Unchecked="Input_Changed" Margin="0,0,8,6" Padding="14,8" ToolTip="Preview input 1 ON / OFF"/>
                                    <ToggleButton x:Name="Input2Toggle" Tag="2" Content="Input 2" Checked="Input_Changed" Unchecked="Input_Changed" Margin="0,0,8,6" Padding="14,8" ToolTip="Preview input 2 ON / OFF"/>
                                    <ToggleButton x:Name="Input3Toggle" Tag="3" Content="Input 3" Checked="Input_Changed" Unchecked="Input_Changed" Margin="0,0,8,6" Padding="14,8" ToolTip="Preview input 3 ON / OFF"/>
                                    <ToggleButton x:Name="Input4Toggle" Tag="4" Content="Input 4" Checked="Input_Changed" Unchecked="Input_Changed" Margin="0,0,8,6" Padding="14,8" ToolTip="Preview input 4 ON / OFF"/>
                                    <ToggleButton x:Name="Input5Toggle" Tag="5" Content="Input 5" Checked="Input_Changed" Unchecked="Input_Changed" Margin="0,0,8,6" Padding="14,8" ToolTip="Preview input 5 ON / OFF"/>
                                    <ToggleButton x:Name="Input6Toggle" Tag="6" Content="Input 6" Checked="Input_Changed" Unchecked="Input_Changed" Margin="0,0,8,6" Padding="14,8" ToolTip="Preview input 6 ON / OFF"/>
                                    <Button x:Name="ClearInputsButton" Content="All off" Click="ClearInputs_Click" Style="{StaticResource QuietButton}" Margin="0,0,0,6"/>
                                </WrapPanel>
                                <TextBlock x:Name="InputStateText" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <WrapPanel x:Name="SegmentPreviewPanel"/>
                                <TextBlock x:Name="SoundPreviewText" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <Expander Header="Stored values" Margin="-6,8,0,0"><TextBox x:Name="PreviewText" IsReadOnly="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/></Expander>
                                <Expander Header="Record a physical check" Margin="-6,0,0,0">
                                    <StackPanel>
                                        <ComboBox x:Name="ObservationCombo" SelectionChanged="Observation_SelectionChanged" Margin="0,4">
                                            <ComboBoxItem Content="Not checked yet" IsSelected="True"/>
                                            <ComboBoxItem Content="The real column matches this state"/>
                                            <ComboBoxItem Content="The real column looks different"/>
                                        </ComboBox>
                                        <TextBlock x:Name="ObservationText" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="OpenPdfButton" Content="Open PDF" Style="{StaticResource QuietButton}" DockPanel.Dock="Right" Click="OpenPdf_Click" IsEnabled="False" Margin="0,-6,-8,-6"/>
                        <TextBlock Text="Configuration sheet" FontSize="16" FontWeight="SemiBold"/>
                    </DockPanel>
                    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Height="360" Margin="0,10,0,0">
                        <Grid>
                            <Image x:Name="PairedPdfImage" Stretch="Uniform" Margin="6"/>
                            <TextBlock x:Name="PairedPdfText" Style="{StaticResource Muted}" TextAlignment="Center" VerticalAlignment="Center" Margin="20" Text="The PDF saved with this configuration shows here."/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Expander Header="More options" Margin="-6,14,0,0">
            <StackPanel>
                <Button x:Name="BrowseButton" Content="Choose a .signal file from this PC…" Click="BrowseButton_Click" HorizontalAlignment="Left" Margin="-4,4,0,8"/>
                <TextBlock Text="Details from the last check or upload" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                <TextBox x:Name="ResultText" Height="130" Margin="0,6,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top"
                         Text="Nothing checked yet."/>
            </StackPanel>
        </Expander>
    </StackPanel>
    </ScrollViewer>
</Window>
