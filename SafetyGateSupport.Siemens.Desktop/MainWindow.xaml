<Window x:Class="SiemensUsbCheck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Signal column • v0.4.0 • Safety Gate Support 7"
        Width="1040" Height="900" MinWidth="720" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA"
        FontFamily="Segoe UI" FontSize="14"
        Loaded="Window_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="ContextText" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,8" Visibility="Collapsed"/>
            <TextBlock Text="Check the light. Fix the configuration." FontSize="25" FontWeight="SemiBold" Foreground="#14263D" />
            <TextBlock Text="Connect → choose this unit’s file → read and compare → check the actual lights."
                       Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#394C60" />
        </StackPanel>

        <Border Grid.Row="1" Padding="14" Background="White" BorderBrush="#D6DEE8" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="8WD4613-5JH37 • isolate the equipment for servicing before USB connection."
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap"
                           Text="Close Siemens Configurator first. Connect the column directly using a USB-C data cable. Windows must recognize its serial port." />
                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#88520A"
                           Text="Opening USB can restart the column. Upload replaces its settings and requests a restart. A backup is saved before uploading, and stored settings are checked after restart. Physical operation must be checked separately." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Label Target="{Binding ElementName=DeviceCombo}" Padding="0,0,0,6" Content="_USB column" FontWeight="SemiBold" />
                <ComboBox x:Name="DeviceCombo" IsEditable="False" MinHeight="36" Padding="8,5"
                          SelectionChanged="DeviceCombo_SelectionChanged" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="_Refresh" Margin="10,0,0,0"
                    VerticalAlignment="Bottom" Click="RefreshButton_Click" />
        </Grid>

        <TextBlock x:Name="DetectionText" Grid.Row="3" Margin="0,7,0,0" Foreground="#394C60"
                   TextWrapping="Wrap" Text="Checking connected devices…" />

        <StackPanel Grid.Row="4" Margin="0,16,0,14">
            <ComboBox x:Name="AssignedFilesCombo" DisplayMemberPath="Label" SelectionChanged="AssignedFiles_SelectionChanged" MinHeight="32" Margin="0,0,0,8" Visibility="Collapsed" ToolTip="Explicitly select the approved file for this asset and unit. Multiple files require review."/>
            <DockPanel>
                <Button x:Name="BrowseButton" Content="Choose .signal file…" DockPanel.Dock="Left"
                        Click="BrowseButton_Click" Margin="0,0,12,0" />
                <TextBlock x:Name="SelectedSignalText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Choose this unit’s approved file to compare settings. Reading a backup does not need a file." />
            </DockPanel>
            <TabControl x:Name="WorkflowTabs" Margin="0,14,0,0">
             <TabItem Header="Read &amp; compare"><StackPanel Margin="14">
            <WrapPanel Margin="0,0,0,0">
                <Button x:Name="ReadButton" Content="_Read &amp; compare…" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="ReadButton_Click" />
                <Button x:Name="UploadButton" Content="_Upload selected file…" FontWeight="SemiBold" Margin="10,0,0,0"
                        IsEnabled="False" Click="UploadButton_Click" />
                <Button x:Name="CancelButton" Content="_Cancel" Margin="10,0,0,0" IsEnabled="False" Click="CancelButton_Click" />
            </WrapPanel>
        <TextBox x:Name="ResultText" Height="140" Margin="0,12,0,6" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 Padding="12" BorderBrush="#D6DEE8" Background="White"
                 Text="Select the spare column. Read saves a backup report; Upload uses the selected .signal file. No device opens until you start a read or confirm an upload." />
             </StackPanel></TabItem>
             <TabItem Header="Expected lights &amp; sound">
                <StackPanel Margin="14">
                    <TextBlock Text="Which inputs are ON? Match the safely observed input signals from the drawing." TextWrapping="Wrap" Margin="0,10,0,6"/>
                    <TextBlock Text="These switches change the preview only. They never operate the real column." Foreground="#536E81" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,8">
                     <ToggleButton x:Name="Input1Toggle" Tag="1" Content="Input 1" Checked="Input_Changed" Unchecked="Input_Changed" Margin="0,0,8,6" Padding="14,10" ToolTip="Preview input 1 ON / OFF"/>
                     <ToggleButton x:Name="Input2Toggle" Tag="2" Content="Input 2" Checked="Input_Changed" Unchecked="Input_Changed" Margin="0,0,8,6" Padding="14,10" ToolTip="Preview input 2 ON / OFF"/>
                     <ToggleButton x:Name="Input3Toggle" Tag="3" Content="Input 3" Checked="Input_Changed" Unchecked="Input_Changed" Margin="0,0,8,6" Padding="14,10" ToolTip="Preview input 3 ON / OFF"/>
                     <ToggleButton x:Name="Input4Toggle" Tag="4" Content="Input 4" Checked="Input_Changed" Unchecked="Input_Changed" Margin="0,0,8,6" Padding="14,10" ToolTip="Preview input 4 ON / OFF"/>
                     <ToggleButton x:Name="Input5Toggle" Tag="5" Content="Input 5" Checked="Input_Changed" Unchecked="Input_Changed" Margin="0,0,8,6" Padding="14,10" ToolTip="Preview input 5 ON / OFF"/>
                     <ToggleButton x:Name="Input6Toggle" Tag="6" Content="Input 6" Checked="Input_Changed" Unchecked="Input_Changed" Margin="0,0,8,6" Padding="14,10" ToolTip="Preview input 6 ON / OFF"/>
                     <Button x:Name="ClearInputsButton" Content="All OFF" Click="ClearInputs_Click" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock x:Name="InputStateText" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Border Background="White" BorderBrush="#DFE6ED" BorderThickness="1" CornerRadius="10" Padding="16">
                     <StackPanel><TextBlock Text="Expected appearance" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Stored segment order; confirm physical orientation against the drawing." Foreground="#536E81" TextWrapping="Wrap" Margin="0,4,0,10"/><WrapPanel x:Name="SegmentPreviewPanel"/><TextBlock x:Name="SoundPreviewText" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
                    </Border>
                    <Expander Header="Stored values and effect details" Margin="0,8"><TextBox x:Name="PreviewText" IsReadOnly="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto"/></Expander>
                    <ComboBox x:Name="ObservationCombo" SelectionChanged="Observation_SelectionChanged" Margin="0,5">
                        <ComboBoxItem Content="Physical operation has not been checked" IsSelected="True"/>
                        <ComboBoxItem Content="Observed lights / sound match this state"/>
                        <ComboBoxItem Content="Observed lights / sound differ from this state"/>
                    </ComboBox>
                    <TextBlock x:Name="ObservationText" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
            </TabControl>
        </StackPanel>



        <TextBlock x:Name="StatusText" Grid.Row="6" Margin="0,12,0,0" Foreground="#394C60"
                   TextWrapping="Wrap" Text="Ready. Device detection does not open USB." />
    </Grid>
    </ScrollViewer>
</Window>
