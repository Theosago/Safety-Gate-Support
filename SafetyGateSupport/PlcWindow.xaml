<Window x:Class="SafetyGateSupport.PlcWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PLC — asset information" Width="780" Height="570" MinWidth="640" MinHeight="470" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock x:Name="AssetText" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="PLC information and files are shared across this asset’s units." Foreground="#61788A" TextWrapping="Wrap" Margin="0,8,0,18"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="PLC model" FontWeight="SemiBold"/><TextBlock x:Name="ModelText" Margin="0,6,0,20" TextWrapping="Wrap"/><TextBlock Text="Address / IP" FontWeight="SemiBold"/><TextBox x:Name="AddressText" IsReadOnly="True" Margin="0,6,0,20"/><TextBlock Text="Notes" FontWeight="SemiBold"/><TextBlock x:Name="NotesText" TextWrapping="Wrap" Margin="0,6,0,20"/><TextBlock Text="Edit these details in Setup Mode → Gates &amp; Units → Asset information and PLC settings." TextWrapping="Wrap" Foreground="#61788A"/></StackPanel></ScrollViewer>
  <WrapPanel Grid.Row="2" Margin="0,16,0,0"><Button x:Name="FilesButton" Content="Open PLC files" Click="Files_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Close" Click="Close_Click"/></WrapPanel>
 </Grid>
</Window>
