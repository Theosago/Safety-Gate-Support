<Window x:Class="SafetyGateSupport.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Safety Gate Support" Height="790" Width="1220" MinHeight="680" MinWidth="1000"
 WindowStartupLocation="CenterScreen" PreviewKeyDown="MainWindow_PreviewKeyDown">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="#D6DCE2" BorderThickness="0,0,1,0">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="14,18,14,10">
     <TextBlock Text="Safety Gate" FontWeight="Bold" FontSize="19"/><TextBlock Text="Support" FontSize="16" Foreground="#555"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,12,0,0">
     <Button Style="{StaticResource NavButton}" Content="⌂   Home" Click="HomeNav_Click"/>
     <Button Style="{StaticResource NavButton}" Content="☷   Systems" Click="SystemsNav_Click"/>
     <Button Style="{StaticResource NavButton}" Content="▤   Manuals" Click="ManualsNav_Click"/>
     <Button Style="{StaticResource NavButton}" Content="⚙   Parts" Click="PartsNav_Click"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="16,10,12,18">
     <TextBlock x:Name="ConnectionText" FontSize="12" TextWrapping="Wrap"/>
     <Button x:Name="SetupButton" Content="Set Up Shared Data" Click="SetupSharedData_Click" Visibility="Collapsed" Padding="8,5" Margin="0,8,0,0"/>
     <TextBlock Text="v6.4.2" Foreground="#999" FontSize="10" Margin="0,8,0,0"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Column="1" Margin="22">
   <!-- HOME -->
   <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="930" HorizontalAlignment="Stretch">
     <TextBlock Text="Safety Gate Support" FontSize="30" FontWeight="Bold"/>
     <TextBlock x:Name="HomeSubtitleText" Foreground="#555" FontSize="15" Margin="0,4,0,18" TextWrapping="Wrap"/>

     <GroupBox Header="Search everything">
      <StackPanel Margin="12">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="GlobalSearchBox" Height="38" FontSize="16" VerticalContentAlignment="Center" ToolTip="Try: scanner, manual, asset 1226, drawing, part number..." TextChanged="GlobalSearchBox_TextChanged" KeyDown="GlobalSearchBox_KeyDown"/>
        <Button Grid.Column="1" Content="Search" Click="GlobalSearch_Click" Padding="22,7"/>
       </Grid>
       <ListBox x:Name="GlobalSearchResults" Margin="0,8,0,0" MaxHeight="300" MouseDoubleClick="GlobalSearchResults_DoubleClick" Visibility="Collapsed">
        <ListBox.ItemTemplate>
         <DataTemplate>
          <StackPanel Margin="4,5" MaxWidth="820">
           <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Subtitle}" Foreground="#666" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
       <TextBlock x:Name="SearchHintText" Foreground="#666" Margin="4,5,0,0" Text="Start typing to search systems, notes, drawings, manuals, configs, and parts."/>
      </StackPanel>
     </GroupBox>

     <TextBlock Text="Browse by area" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,6"/>
     <WrapPanel x:Name="HomeCategoryPanel"/>

     <Button Content="Troubleshoot a System" Click="HomeTroubleshoot_Click" MinHeight="54" Margin="4,18,4,2"
             FontSize="17" FontWeight="SemiBold" Background="#EAF2FB" BorderBrush="#1769AA" BorderThickness="1"/>
     <TextBlock Text="Choose an area, asset, and unit, then work through the troubleshooting information for that system."
                Foreground="#666" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="12,2,12,8"/>

     <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <GroupBox Header="Quick help" Grid.Column="0"><StackPanel x:Name="QuickHelpPanel" Margin="8"/></GroupBox>
      <GroupBox Header="Basic troubleshooting" Grid.Column="2"><StackPanel x:Name="TroubleshootingPanel" Margin="8"/></GroupBox>
     </Grid>
    </StackPanel>
   </ScrollViewer>

   <!-- SYSTEMS -->
   <Grid x:Name="SystemsView" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Systems" FontSize="28" FontWeight="Bold"/>
    <Grid Grid.Row="1" Margin="0,12,0,12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="AreaBox" Height="36" FontSize="15" SelectionChanged="AreaBox_SelectionChanged"/>
     <TextBox x:Name="SystemSearchBox" Grid.Column="2" Height="36" FontSize="16" VerticalContentAlignment="Center" ToolTip="Search asset number or gate manufacturer / system" TextChanged="SystemSearchBox_TextChanged"/>
    </Grid>
    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <GroupBox Header="Safety Gates" Margin="0,0,10,0"><ListBox x:Name="AssetList" Margin="5" DisplayMemberPath="Display" SelectionChanged="AssetList_SelectionChanged"/></GroupBox>
     <GroupBox Header="Units" Grid.Column="1" Margin="0,0,10,0"><ListBox x:Name="UnitList" Margin="5" DisplayMemberPath="UnitDisplay" SelectionChanged="UnitList_SelectionChanged"/></GroupBox>
     <ScrollViewer Grid.Column="2"><StackPanel Margin="8,0,0,0">
      <StackPanel x:Name="NoUnitPanel" VerticalAlignment="Center" Margin="20,80,20,0">
       <TextBlock Text="Select a safety gate, then choose a unit." FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       <TextBlock Text="Nothing opens automatically." Foreground="#666" HorizontalAlignment="Center" Margin="0,8,0,0"/>
      </StackPanel>
      <StackPanel x:Name="UnitDetailPanel" Visibility="Collapsed">
       <TextBlock x:Name="UnitTitleText" FontSize="24" FontWeight="Bold"/>
       <TextBlock x:Name="UnitAreaText" Foreground="#555" Margin="0,2,0,10"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border BorderBrush="#AAA" BorderThickness="1" Padding="4" Height="290"><Image x:Name="GateImage" Stretch="Uniform"/></Border>
        <StackPanel Grid.Column="1" Margin="18,8,0,0">
         <TextBlock x:Name="AssetInfoText" FontSize="17" Margin="0,4"/>
         <TextBlock x:Name="UnitInfoText" FontSize="17" Margin="0,4"/>
         <TextBlock x:Name="TypeInfoText" FontSize="14" Foreground="#555" TextWrapping="Wrap" Margin="0,8,0,0"/>
         <TextBlock x:Name="ModelInfoText" FontSize="14" Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,0"/>
         <TextBlock x:Name="LocationInfoText" FontSize="14" Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,0"/>
         <TextBlock Text="Shared notes" FontWeight="SemiBold" Margin="0,18,0,4"/>
         <TextBox x:Name="SharedNotesBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                  MinHeight="112" MaxHeight="150" Padding="8" TextChanged="SharedNotesBox_TextChanged"
                  ToolTip="Type directly here. Notes auto-save to the shared Q: data and are visible to other users."/>
         <TextBlock x:Name="SharedNotesStatusText" Foreground="#777" FontSize="11" Margin="2,4,0,0" Text="Shared notes auto-save."/>
        </StackPanel>
       </Grid>
       <TextBlock Text="Files / Resources" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,6"/>
       <WrapPanel x:Name="SystemResourcePanel"/>
       <Button Content="Troubleshoot This System" Click="TroubleshootSystem_Click" MinHeight="52" Margin="4,12,4,2"
               FontSize="16" FontWeight="SemiBold" Background="#EAF2FB" BorderBrush="#1769AA" BorderThickness="1"/>
       <TextBlock Text="Gate not opening, scanner fault, signal light issues, and other common problems" Foreground="#666" HorizontalAlignment="Center" Margin="0,2,0,4"/>
      </StackPanel>
     </StackPanel></ScrollViewer>
    </Grid>
   </Grid>

   <!-- MANUALS -->
   <Grid x:Name="ManualsView" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Manuals" FontSize="28" FontWeight="Bold"/>
    <StackPanel Grid.Row="1" Margin="0,8,0,12">
     <TextBlock x:Name="ManualsIntroText" Foreground="#555" TextWrapping="Wrap"/>
     <TextBox x:Name="ManualSearchBox" Height="36" FontSize="16" Margin="0,10,0,0" VerticalContentAlignment="Center" TextChanged="ManualSearchBox_TextChanged" ToolTip="Search manual file names"/>
    </StackPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ListBox x:Name="ManualList" DisplayMemberPath="Name" MouseDoubleClick="ManualList_DoubleClick"/>
     <StackPanel Grid.Column="1" Margin="12,0,0,0"><Button Content="Open" Click="OpenManual_Click"/><Button Content="Open Manuals Folder" Click="OpenManualFolder_Click"/></StackPanel>
    </Grid>
   </Grid>

   <!-- PARTS -->
   <Grid x:Name="PartsView" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Parts" FontSize="28" FontWeight="Bold"/>
    <StackPanel Grid.Row="1" Margin="0,8,0,12">
     <TextBlock x:Name="PartsIntroText" Foreground="#555" TextWrapping="Wrap"/>
     <TextBox x:Name="PartSearchBox" Height="36" FontSize="16" Margin="0,10,0,0" VerticalContentAlignment="Center" TextChanged="PartSearchBox_TextChanged" ToolTip="Search part number, description, manufacturer, keyword, or related asset"/>
    </StackPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ListBox x:Name="PartList" DisplayMemberPath="Display" SelectionChanged="PartList_SelectionChanged"/>
     <ScrollViewer Grid.Column="2"><StackPanel>
      <TextBlock x:Name="PartTitleText" FontSize="22" FontWeight="SemiBold" Text="Select a part."/>
      <TextBlock x:Name="PartManufacturerText" Foreground="#555" Margin="0,5,0,0"/>
      <TextBlock x:Name="PartRelatedText" Foreground="#555" Margin="0,5,0,0" TextWrapping="Wrap"/>
      <TextBlock x:Name="PartNotesText" Margin="0,12,0,0" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,14,0,0"><Button Content="Open Part Document" Click="OpenPartDocument_Click"/><Button Content="Open Storeroom Database" Click="OpenStoreroom_Click"/><Button Content="Check Storeroom for Selected Part" Click="CheckStoreroom_Click"/></WrapPanel>
      <TextBlock Text="Storeroom result" FontWeight="SemiBold" Margin="4,16,0,4"/>
      <Border BorderBrush="#CCC" BorderThickness="1" Padding="10"><TextBlock x:Name="StoreroomResultText" Text="No lookup performed." TextWrapping="Wrap"/></Border>
     </StackPanel></ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
