<Window x:Class="SafetyGateSupport.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Safety Gate Support" Height="790" Width="1220" MinHeight="680" MinWidth="900" ResizeMode="CanResize" WindowState="Maximized"
 Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" PreviewKeyDown="MainWindow_PreviewKeyDown">
 <Window.Resources>
  <DataTemplate x:Key="ReplacementPartCard">
   <Border BorderBrush="{DynamicResource ThemeBorderBrushD5DFE8}" BorderThickness="0,0,0,1" Padding="0,10">
    <StackPanel><Border Height="130" Background="{DynamicResource ThemeBackgroundEDF1F4}" Margin="0,0,0,8"><Grid><TextBlock Text="No part photo" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForeground617585}"/><Image Stretch="Uniform" Loaded="PartThumbnail_Loaded" Unloaded="PartThumbnail_Unloaded" DataContextChanged="PartThumbnail_DataContextChanged"/></Grid></Border><TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding AvailableDisplay}" Foreground="{Binding AvailableColor}" FontWeight="Bold" Margin="0,6,0,3"/>
     <TextBlock TextWrapping="Wrap"><Run Text="{Binding InventoryLocationLabel, Mode=OneWay}"/><Run Text="{Binding InventoryLocationDisplay, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
     <TextBlock Text="{Binding PartNumber, StringFormat='Item ID: {0}'}" Foreground="{DynamicResource ThemeForeground617585}"/>
    </StackPanel>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{StaticResource Sidebar}">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="20,22,16,14">
     <Image Source="{StaticResource GrangesStacked}" Stretch="Uniform" Height="56" HorizontalAlignment="Left" Margin="0,0,0,14" AutomationProperties.Name="Gränges"/>
     <TextBlock Text="Safety Gate Support" Foreground="#F2F7FB" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap"/>
     <TextBlock Text="Engineering &amp; maintenance" Foreground="#8FA8BC" FontSize="12" Margin="0,2,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,12,0,0">
     <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Click="HomeNav_Click" AutomationProperties.Name="Find a unit"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" VerticalAlignment="Center"/><TextBlock Text="Find a unit" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="SystemsNav" Style="{StaticResource NavButton}" Click="SystemsNav_Click" AutomationProperties.Name="Selected unit"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" VerticalAlignment="Center"/><TextBlock Text="Selected unit" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="TroubleshootNav" Style="{StaticResource NavButton}" Click="TroubleshootNav_Click" AutomationProperties.Name="Troubleshoot"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" VerticalAlignment="Center"/><TextBlock Text="Troubleshoot" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="ManualsNav" Style="{StaticResource NavButton}" Click="ManualsNav_Click" AutomationProperties.Name="Manuals"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" VerticalAlignment="Center"/><TextBlock Text="Manuals" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="PartsNav" Style="{StaticResource NavButton}" Click="PartsNav_Click" AutomationProperties.Name="Parts catalog"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" VerticalAlignment="Center"/><TextBlock Text="Parts catalog" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="PublishDriveNav" Style="{StaticResource NavButton}" Click="PublishDrive_Click" Visibility="Collapsed" AutomationProperties.Name="Publish &amp; print QR"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" VerticalAlignment="Center"/><TextBlock Text="Publish &amp; print QR" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="SupportLibraryNav" Style="{StaticResource NavButton}" Click="SupportLibrary_Click" AutomationProperties.Name="Support library"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" VerticalAlignment="Center"/><TextBlock Text="Support library" VerticalAlignment="Center"/></StackPanel></Button>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="0,10,0,16">
     <Button x:Name="SetupButton" Style="{StaticResource NavButton}" Click="SetupSharedData_Click" Visibility="Collapsed" ToolTip="Open Plant setup (Ctrl+Alt+Shift+A)" AutomationProperties.Name="Plant setup"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" VerticalAlignment="Center"/><TextBlock Text="Plant setup" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="CloseDemoButton" Content="Close demo" Click="CloseDemo_Click" Visibility="Collapsed" Margin="20,6,20,0"/>
     <Border Margin="20,12,20,0" Padding="0,12,0,0" BorderBrush="#24384A" BorderThickness="0,1,0,0">
      <StackPanel>
       <TextBlock x:Name="ConnectionText" FontSize="12" TextWrapping="Wrap" Foreground="#9FB6C8"/>
       <DockPanel Margin="0,10,0,0">
        <TextBlock Text="v8.6.1" Foreground="#6F889C" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Right"/>
        <TextBlock Text="Theme" Foreground="#9FB6C8" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="ThemeBox" SelectionChanged="Theme_Changed" MinHeight="30" Padding="9,4,30,4" Width="96" HorizontalAlignment="Left" AutomationProperties.Name="Theme"><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox>
       </DockPanel>
      </StackPanel>
     </Border>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Column="1" Margin="22">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="PartsRailColumn" Width="0"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <!-- One search bar for the whole app: filters the unit photos and finds documents, parts and notes. -->
   <StackPanel x:Name="SearchHeader" Grid.ColumnSpan="3" Margin="0,0,0,16">
    <Border x:Name="SearchBarSurface" Background="{DynamicResource Surface}" BorderThickness="1" CornerRadius="12" Padding="14,0,6,0" MinHeight="52" Effect="{StaticResource CardShadow}">
     <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusRing}"/></Trigger></Style.Triggers></Style></Border.Style>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource ThemeForeground61788A}" IsHitTestVisible="False"/>
      <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Search units, drawings, manuals, parts and notes" FontSize="17" VerticalAlignment="Center" Margin="3,0,0,0" Foreground="{DynamicResource ThemeForeground8293A1}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
      <TextBox x:Name="UnitSearchBox" Grid.Column="1" MinHeight="48" FontSize="17" BorderThickness="0" Background="Transparent" Padding="0" VerticalContentAlignment="Center"
               TextChanged="UnitSearch_Changed" PreviewKeyDown="UnitSearch_PreviewKeyDown"
               ToolTip="Asset number, unit, location, model, drawing, manual, part or note (Ctrl+F)" AutomationProperties.Name="Search everything"/>
      <Button x:Name="ClearSearchButton" Grid.Column="2" Style="{StaticResource QuietButton}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Padding="10,8" Margin="4" Click="ClearSearch_Click" Visibility="Collapsed" ToolTip="Clear search (Esc)" AutomationProperties.Name="Clear search"/>
     </Grid>
    </Border>
    <TextBlock x:Name="SearchHintText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeForeground61788A}" Margin="6,6,0,0" Text="Type an asset number, location, part, manual or note. Press Ctrl+F from any page."/>
   </StackPanel>
   <Border Grid.Row="1" x:Name="PartsRail" Visibility="Collapsed" Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="18,0,0,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel>
      <DockPanel LastChildFill="True">
       <Button Content="Close" Click="ClosePartsRail_Click" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="6,0,0,0"/>
       <TextBlock x:Name="PartsRailTitle" Text="Replacement parts" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
      </DockPanel>
      <StackPanel x:Name="RailStockroomControls">
       <TextBlock Text="Stockroom plant" Margin="0,14,0,4"/>
       <ComboBox x:Name="RailPlantBox" DisplayMemberPath="Name" SelectionChanged="RailPlant_SelectionChanged"/>
       <WrapPanel Margin="0,6,0,0"><Button x:Name="RailRefreshStockroomButton" Content="Refresh stock" Click="CheckStoreroom_Click"/><Button x:Name="RailCancelStockroomButton" Content="Cancel check" Click="CancelStockroom_Click" Visibility="Collapsed"/><Button Content="Save stockroom report…" Click="SaveStockroomReport_Click"/></WrapPanel>
      </StackPanel>
      <TextBlock x:Name="RailStockStatus" TextWrapping="Wrap" Foreground="{DynamicResource ThemeForeground617585}" Margin="0,8"/>
      <WrapPanel><Button x:Name="ConfigureUnitPartsButton" Content="Choose unit parts…" Click="ConfigureUnitParts_Click" Visibility="Collapsed"/><Button Content="Browse catalog" Click="PartsNav_Click"/></WrapPanel>
      <TextBlock x:Name="RailPartsEmpty" TextWrapping="Wrap" Foreground="{DynamicResource ThemeForeground617585}" Margin="0,8"/>
     </StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="RailPartsList" ItemTemplate="{StaticResource ReplacementPartCard}"/></ScrollViewer>
    </Grid>
   </Border>
   <Grid Grid.Row="1" x:Name="CommonProblemsRail" Grid.Column="2" Width="300" Margin="12,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Button x:Name="CommonProblemsToggle" Content="Common Problems ▶" Margin="0" Click="ToggleCommonProblems_Click" ToolTip="Collapse or expand Common Problems" AutomationProperties.Name="Toggle Common Problems"/>
    <Border x:Name="CommonProblemsBody" Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Margin="0,6,0,0"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Does this look familiar?" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Select a photo to see the fix." TextWrapping="Wrap" Margin="0,5,0,12"/><TextBlock x:Name="CommonProblemsEmpty" Text="No common problems have been added yet. Add photos and fix instructions in Setup → Home / Help." TextWrapping="Wrap"/></StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="CommonProblemsList"><ItemsControl.ItemTemplate><DataTemplate>
      <Button Tag="{Binding Topic}" Click="CommonProblem_Click" Style="{StaticResource CardButton}" HorizontalContentAlignment="Stretch" Padding="10" Margin="2,0,2,12" AutomationProperties.Name="{Binding Topic.Title}"><StackPanel>
       <Border Height="160" Background="{DynamicResource SurfaceAlt}" CornerRadius="8"><Grid><Image Source="{Binding Photo}" Stretch="Uniform"/><TextBlock Text="{Binding PhotoMessage}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Photo}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
       <TextBlock Text="{Binding Topic.Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,5"/><TextBlock Text="See how to fix it →" Foreground="{DynamicResource ThemeForeground176B87}"/>
      </StackPanel></Button>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Grid></Border></Grid>
   <!-- HOME -->
   <Grid Grid.Row="1" x:Name="HomeShell"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
     <StackPanel Margin="0,0,0,14">
      <TextBlock x:Name="HomeHeadingText" Text="Find a unit" Style="{StaticResource PageTitle}"/>
      <TextBlock x:Name="GalleryIntroText" Text="Select the unit’s photo, or search above for any unit, drawing, manual, part or note." Style="{StaticResource PageSubtitle}"/>
     </StackPanel>
     <Border x:Name="SearchResultsPanel" Visibility="Collapsed" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,14">
      <StackPanel>
       <TextBlock x:Name="SearchResultsHeading" Text="Matches" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForeground405D70}" Margin="2,0,0,6"/>
       <ListBox x:Name="GlobalSearchResults" MaxHeight="250" BorderThickness="0" KeyDown="GlobalSearchResults_KeyDown" AutomationProperties.Name="Search results">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="6,6"/><Setter Property="Cursor" Value="Hand"/><EventSetter Event="PreviewMouseLeftButtonUp" Handler="SearchResultItem_Click"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
         <DataTemplate>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Border Background="{DynamicResource ThemeBackgroundEAF3F7}" CornerRadius="5" Padding="7,2" Margin="0,1,10,0" VerticalAlignment="Top" MinWidth="64"><TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeForeground176B87}"/></Border>
           <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource ThemeForeground666666}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
           </StackPanel>
          </Grid>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
      </StackPanel>
     </Border>
     <WrapPanel Margin="0,0,0,8"><Button x:Name="AllAreasButton" HorizontalContentAlignment="Center" Content="All areas" Click="AllAreas_Click"/><WrapPanel x:Name="HomeCategoryPanel"/></WrapPanel>
     <TextBlock x:Name="GalleryStatusText" Text="Loading units…" Foreground="{DynamicResource ThemeForeground536E81}" TextWrapping="Wrap" Margin="4,0,0,12"/>
    </StackPanel><ScrollViewer x:Name="HomeView" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <ItemsControl x:Name="UnitGallery"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button Click="UnitCard_Click" Tag="{Binding Unit}" Width="236" Style="{StaticResource CardButton}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Padding="10" Margin="0,0,14,14" AutomationProperties.Name="{Binding Title}">
        <StackPanel>
         <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Height="270" Padding="4"><Grid>
          <Image Source="{Binding Photo}" Stretch="Uniform" AutomationProperties.Name="{Binding Title}"/>
          <TextBlock Text="{Binding PhotoMessage}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource ThemeForeground61788A}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Photo}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers><Setter Property="Visibility" Value="Collapsed"/></Style></TextBlock.Style></TextBlock>
         </Grid></Border>
         <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,12,4,3"/>
         <TextBlock Text="{Binding Location}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkMuted}" Margin="4,0,4,4"/>
        </StackPanel>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock x:Name="GalleryEmptyText" Text="No matching units. Try another asset number or select All areas." TextWrapping="Wrap" Margin="4,20" Visibility="Collapsed" FontSize="18"/>
     <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,18"><Button x:Name="PreviousUnitsButton" Content="← Previous units" Click="PreviousUnits_Click"/><TextBlock x:Name="GalleryPageText" VerticalAlignment="Center" Margin="14,0"/><Button x:Name="NextUnitsButton" Content="More units →" Click="NextUnits_Click"/></WrapPanel>
     <TextBlock x:Name="HomeSubtitleText" Foreground="{DynamicResource ThemeForeground555555}" FontSize="15" Margin="0,4,0,10" TextWrapping="Wrap"/>

     <GroupBox Header="Quick help" Margin="0,12,0,0"><StackPanel x:Name="QuickHelpPanel" Margin="8"/></GroupBox>
    </StackPanel>
   </ScrollViewer>
</Grid>

   <ScrollViewer Grid.Row="1" x:Name="TroubleshootView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <TextBlock Text="Troubleshoot" Style="{StaticResource PageTitle}"/>
     <TextBlock Text="Start with what you can observe. Check Common Problems for a known symptom, or choose a unit for guided checks." TextWrapping="Wrap" Foreground="{DynamicResource ThemeForeground536E81}" Margin="0,6,0,18"/>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
       <TextBlock Text="Guided troubleshooting" FontSize="21" FontWeight="SemiBold"/>
       <TextBlock Text="Select the asset and unit, confirm its photo, then follow the checks for the symptom you see." TextWrapping="Wrap" Margin="0,6,0,12"/>
       <Button x:Name="StartGuidedTroubleshootingButton" Content="Choose a unit to troubleshoot…" Click="StartGuidedTroubleshooting_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
      </StackPanel>
     </Border>
     <GroupBox Header="Troubleshooting reference"><StackPanel x:Name="TroubleshootingPanel" Margin="8"/></GroupBox>
    </StackPanel>
   </ScrollViewer>

   <!-- The unit workspace keeps the selected identity while tools open. -->
   <Grid Grid.Row="1" x:Name="SystemsView" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
     <Button x:Name="ChangeUnitButton" Content="← All units" Click="HomeNav_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>
     <DockPanel LastChildFill="True">
      <Button x:Name="UnitPartsButton" Content="Replacement parts" Click="UnitParts_Click" DockPanel.Dock="Right"
              Style="{StaticResource PrimaryButton}" MinHeight="38" VerticalAlignment="Center" Margin="12,0,0,0" IsEnabled="False"/>
      <Button x:Name="MaintainXWorkOrdersButton" Content="MaintainX work orders" Click="MaintainXWorkOrders_Click" DockPanel.Dock="Right"
              MinHeight="38" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed"/>
      <StackPanel>
       <TextBlock x:Name="UnitTitleText" Text="Select a unit" Style="{StaticResource PageTitle}"/>
       <TextBlock x:Name="UnitAreaText" Foreground="{DynamicResource ThemeForeground536E81}" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </DockPanel>
    </StackPanel>
    <ScrollViewer x:Name="UnitWorkspaceScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <StackPanel x:Name="NoUnitPanel" Margin="24"><TextBlock Text="Select a unit to see its photo, files and troubleshooting." FontSize="21" TextWrapping="Wrap"/><Button Content="Find a unit" Click="HomeNav_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel>
     <StackPanel x:Name="UnitDetailPanel" Visibility="Collapsed">

      <Grid x:Name="UnitOverview" SizeChanged="UnitOverview_SizeChanged">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition x:Name="UnitCardGap" Width="16"/><ColumnDefinition x:Name="UnitDrawingColumn" Width="*"/>
       </Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top">
        <StackPanel>
         <TextBlock Text="Identification photo" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
         <Button x:Name="EnlargePhotoButton" Click="EnlargePhoto_Click" Padding="3" Margin="0" HorizontalContentAlignment="Stretch" ToolTip="Open the full identification photo">
          <Border Background="{DynamicResource SurfaceAlt}" Height="260" CornerRadius="8">
           <Grid>
            <Image x:Name="GateImage" Stretch="Uniform"/>
            <TextBlock x:Name="UnitPhotoMessage" Text="Loading identification photo…" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource ThemeForeground61788A}" Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
           </Grid>
          </Border>
         </Button>
         <TextBlock Text="Unit files" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
         <WrapPanel x:Name="UnitActionsPanel">
          <Button x:Name="PartManualsButton" Content="Manuals / documents" Click="UnitManuals_Click" MinHeight="36"/>
          <Button x:Name="PlcButton" Content="PLC files" Click="Plc_Click" MinHeight="36" ToolTip="Open saved PLC code, backups and connection details for this asset"/>
          <Button x:Name="LightColumnButton" Content="Light / signal column" Click="LightColumn_Click" MinHeight="36" ToolTip="Open this unit’s assigned Siemens configurations and column tools"/>
          <Button x:Name="ScannerButton" Content="Safety scanner" Click="Scanner_Click" MinHeight="36" ToolTip="Open this unit’s assigned scanner files and read-only USB diagnostics"/>
         </WrapPanel>
        </StackPanel>
       </Border>
       <Border x:Name="UnitDrawingCard" Grid.Column="2" Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top">
        <StackPanel>
         <TextBlock Text="Drawings and guide PDFs" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
         <ComboBox x:Name="DrawingFileBox" DisplayMemberPath="Name" SelectionChanged="DrawingFile_Changed" Visibility="Collapsed" Margin="0,0,0,6" AutomationProperties.Name="Drawings and guide PDFs for this unit"/>
         <TextBlock x:Name="DrawingFileText" TextWrapping="Wrap" FontWeight="SemiBold"/>
         <TextBlock x:Name="DrawingCoverageText" TextWrapping="Wrap" Foreground="{DynamicResource ThemeForeground61788A}" FontSize="12"/>
         <Border x:Name="DrawingPreviewSurface" Height="280" Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Margin="0,8,0,0" Cursor="Hand" MouseLeftButtonUp="DrawingPreview_Click" ToolTip="Click to open the full drawing">
          <Grid><Image x:Name="DrawingImage" Stretch="Uniform"/><TextBlock x:Name="DrawingMessage" Text="Loading electrical drawing…" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"/></Grid>
         </Border>
         <WrapPanel x:Name="DrawingPageControls" Visibility="Collapsed" Margin="0,6,0,0">
          <Button x:Name="PreviousDrawingPageButton" Content="← Page" Click="PreviousDrawingPage_Click" IsEnabled="False"/>
          <TextBlock x:Name="DrawingPageText" VerticalAlignment="Center" Margin="8,0"/>
          <Button x:Name="NextDrawingPageButton" Content="Page →" Click="NextDrawingPage_Click" IsEnabled="False"/>
         </WrapPanel>
         <TextBlock x:Name="DrawingPairStatusText" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForeground965813}" Margin="0,6,0,0"/>
         <TextBlock x:Name="DrawingOrientationText" Foreground="{DynamicResource ThemeForeground61788A}" FontSize="12" TextWrapping="Wrap"/>
         <TextBlock x:Name="DrawingAssignmentText" TextWrapping="Wrap" Foreground="{DynamicResource ThemeForeground61788A}" FontSize="12"/>
         <WrapPanel Margin="0,8,0,0">
          <Button x:Name="ReplaceDrawingButton" Content="Replace selected drawing…" Click="ReplaceDrawing_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False" Visibility="Collapsed"/>
          <Button x:Name="UploadDrawingButton" Content="Add drawing pair…" Click="AddDrawing_Click"/>
          <Button x:Name="FilesButton" Content="Manage drawings…" Click="FindFiles_Click"/>
          <Button x:Name="RemoveGuidePdfButton" Content="Remove from this unit…" Click="RemoveGuidePdf_Click" Visibility="Collapsed" ToolTip="Take this guide PDF off this unit's guide. The file is archived, not deleted."/>
          <TextBlock FontSize="12" VerticalAlignment="Center" Margin="6,4"><Hyperlink x:Name="DownloadPdfLink" Click="DownloadDrawing_Click" IsEnabled="False">Download PDF</Hyperlink><Run Text="   ·   "/><Hyperlink x:Name="DownloadDwgLink" Click="DownloadDrawing_Click" IsEnabled="False">Download DWG</Hyperlink></TextBlock>
         </WrapPanel>
         <TextBlock x:Name="DrawingPublishStatus" TextWrapping="Wrap" Foreground="{DynamicResource ThemeForeground61788A}"/>
        </StackPanel>
       </Border>
       <GroupBox x:Name="SharedNotesPanel" Header="Shared notes" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
        <StackPanel>
         <TextBox x:Name="SharedNotesBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="90" MaxHeight="180" TextChanged="SharedNotesBox_TextChanged"/>
         <TextBlock x:Name="SharedNotesStatusText" Text="Shared notes auto-save." Foreground="{DynamicResource ThemeForeground61788A}" FontSize="12" Margin="2,6,0,0"/>
        </StackPanel>
       </GroupBox>
      </Grid>
      <Grid x:Name="InlineToolPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="← Unit overview" Click="UnitOverview_Click" HorizontalAlignment="Left"/><ContentControl x:Name="InlineToolContent" Grid.Row="1"/></Grid>
      </StackPanel>
     <Expander Visibility="Collapsed" Header="Browse by asset and unit list" Margin="0,20,0,8"><StackPanel>
      <Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="AreaBox" SelectionChanged="AreaBox_SelectionChanged"/></Grid>
      <Grid Height="230"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox x:Name="AssetList" DisplayMemberPath="Display" SelectionChanged="AssetList_SelectionChanged"/><ListBox x:Name="UnitList" Grid.Column="1" DisplayMemberPath="UnitDisplay" Margin="10,0,0,0" SelectionChanged="UnitList_SelectionChanged"/></Grid>
     </StackPanel></Expander>
    </StackPanel></ScrollViewer>
   </Grid>

   <Grid Grid.Row="1" x:Name="CommonProblemView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><Button x:Name="CommonProblemBackButton" Content="← Back" Click="CommonProblemBack_Click" HorizontalAlignment="Left"/><TextBlock x:Name="CommonProblemTitle" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" Margin="0,12"/></StackPanel>
    <ScrollViewer x:Name="CommonProblemScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="How to recognize and fix this problem" FontSize="20" FontWeight="SemiBold" Margin="0,8"/>
     <TextBlock x:Name="CommonProblemInstructions" TextWrapping="Wrap" FontSize="16" LineHeight="26"/>
     <ItemsControl x:Name="CommonProblemGallery"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,16"><Image Source="{Binding Source}" MaxHeight="480" Stretch="Uniform"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer>
   </Grid>

   <!-- MANUALS -->
   <Grid Grid.Row="1" x:Name="ManualsView" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel><Button Content="Choose this unit’s manuals…" Click="ChooseUnitManuals_Click" DockPanel.Dock="Right"/><TextBlock Text="Manuals &amp; documents" Style="{StaticResource PageTitle}"/></DockPanel>
    <StackPanel Grid.Row="1" Margin="0,8,0,12">
     <TextBlock x:Name="ManualsIntroText" Foreground="{DynamicResource ThemeForeground555555}" TextWrapping="Wrap"/>
     <TextBlock x:Name="ManualImportStatus" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ListBox x:Name="ManualList" DisplayMemberPath="Name" MouseDoubleClick="ManualList_DoubleClick"/>
     <StackPanel Grid.Column="1" Margin="12,0,0,0">
      <Button Content="Open" Click="OpenManual_Click"/>
      <Button x:Name="ImportManualsButton" Content="Import documents…" Click="ImportManuals_Click" IsEnabled="False"/>
      <Button Content="Open Manuals Folder" Click="OpenManualFolder_Click"/>
     </StackPanel>
    </Grid>
   </Grid>

   <!-- PARTS -->
   <Grid Grid.Row="1" x:Name="PartsView" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Parts catalog" Style="{StaticResource PageTitle}"/>
    <StackPanel Grid.Row="1" Margin="0,8,0,12">
     <TextBlock x:Name="PartsIntroText" Foreground="{DynamicResource ThemeForeground555555}" TextWrapping="Wrap"/>
     <WrapPanel x:Name="CatalogStockroomSelector" Margin="0,10,0,0"><TextBlock Text="Stockroom plant" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="StockroomPlantBox" Width="190" DisplayMemberPath="Name" SelectionChanged="StockroomPlant_SelectionChanged"/><TextBlock x:Name="StockroomPlantHint" Text="Choose a plant for current stock levels" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource ThemeForeground566D7C}"/></WrapPanel>
     <TextBlock x:Name="PartCatalogEmpty" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="4*" MinWidth="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="6*" MinWidth="360"/></Grid.ColumnDefinitions>
     <ListBox x:Name="PartList" SelectionChanged="PartList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="9"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Background="{DynamicResource ThemeBackgroundEDF1F5}" CornerRadius="6" Width="66" Height="76" VerticalAlignment="Top"><Grid><TextBlock Text="Photo" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForeground8293A1}"/><Image Stretch="Uniform" Margin="3" Loaded="PartThumbnail_Loaded" Unloaded="PartThumbnail_Unloaded" DataContextChanged="PartThumbnail_DataContextChanged"/></Grid></Border>
       <StackPanel Grid.Column="1"><TextBlock Text="{Binding Description}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding AvailableDisplay}" Foreground="{Binding AvailableColor}" FontWeight="Bold" Margin="0,6,0,3"/><TextBlock Foreground="{DynamicResource ThemeForeground1B637A}" Margin="0,5,0,3" TextWrapping="Wrap"><Run Text="{Binding InventoryLocationLabel, Mode=OneWay}"/><Run Text="{Binding InventoryLocationDisplay, Mode=OneWay}" FontWeight="Bold"/></TextBlock><TextBlock Text="{Binding PartNumber, StringFormat='Item ID: {0}'}" Foreground="{DynamicResource ThemeForeground687A88}" TextWrapping="Wrap"/></StackPanel>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource ThemeBackgroundCED8E1}" ToolTip="Drag to adjust the parts list and detail widths"/>
     <ScrollViewer x:Name="PartDetailScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="8,0,10,12">
      <TextBlock x:Name="PartTitleText" FontSize="23" FontWeight="SemiBold" Text="Select a part." TextWrapping="Wrap"/>
      <TextBlock x:Name="PartAvailableText" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/>
      <TextBlock Text="Reported bin (original snapshot)" Foreground="{DynamicResource ThemeForeground687A88}" Margin="0,7,0,0"/>
      <TextBlock x:Name="PartLocationText" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource ThemeForeground1B637A}" Margin="0,7,0,4" TextWrapping="Wrap"/>
      <TextBlock x:Name="PartStockText" Foreground="{DynamicResource ThemeForeground617585}" TextWrapping="Wrap"/>
      <Border Height="300" Background="{DynamicResource ThemeBackgroundF7F9FC}" BorderBrush="{DynamicResource ThemeBorderBrushD5DFE8}" BorderThickness="1" CornerRadius="8" Margin="0,14,0,6"><Grid>
       <TextBlock x:Name="PartPhotoMessage" Text="Select a part to see its photo." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Foreground="{DynamicResource ThemeForeground687A88}"/>
       <Image x:Name="PartPhotoImage" Stretch="Uniform" Margin="8"/>
      </Grid></Border>
      <WrapPanel><Button x:Name="UploadPartPhotoButton" Content="Upload / replace photo…" Click="UploadPartPhoto_Click" IsEnabled="False"/><Button x:Name="EnlargePartPhotoButton" Content="Larger photo" Click="EnlargePartPhoto_Click" IsEnabled="False"/></WrapPanel>
      <TextBlock x:Name="PartPhotoStatus" Foreground="{DynamicResource ThemeForeground687A88}" TextWrapping="Wrap" Margin="0,3,0,8"/>
      <Border Background="{DynamicResource ThemeBackgroundEAF2F7}" CornerRadius="6" Padding="12" Margin="0,3,0,10"><StackPanel>
       <TextBlock x:Name="PartCurrentQuantityText" Text="Current quantity unavailable" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock x:Name="PartReportedQuantityText" TextWrapping="Wrap" Margin="0,5,0,0"/>
       <TextBlock x:Name="PartStockroomStatusText" TextWrapping="Wrap" Foreground="{DynamicResource ThemeForeground566D7C}" Margin="0,5,0,0"/>
      </StackPanel></Border>
      <TextBlock x:Name="PartManufacturerText" Foreground="{DynamicResource ThemeForeground555555}" Margin="0,5,0,0" TextWrapping="Wrap"/>
      <TextBlock x:Name="PartRelatedText" Foreground="{DynamicResource ThemeForeground555555}" Margin="0,5,0,0" TextWrapping="Wrap"/>
      <TextBlock x:Name="PartNotesText" Margin="0,12,0,0" TextWrapping="Wrap"/>
      <Button Content="Open part document" Click="OpenPartDocument_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
      <WrapPanel x:Name="CatalogStockroomActions" Margin="0,6,0,0"><Button Content="Open stockroom" Click="OpenStoreroom_Click"/><Button x:Name="RefreshStockroomButton" Content="Refresh stock levels" Click="CheckStoreroom_Click"/><Button x:Name="CancelStockroomButton" Content="Cancel check" Click="CancelStockroom_Click" Visibility="Collapsed"/></WrapPanel>
      <TextBlock x:Name="StoreroomResultText" Text="Stockroom has not been checked." TextWrapping="Wrap" Foreground="{DynamicResource ThemeForeground687A88}" Margin="0,8,0,0"/>
     </StackPanel></ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
