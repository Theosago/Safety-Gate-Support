<Window x:Class="SafetyGateSupport.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Safety Gate Support" Height="790" Width="1220" MinHeight="680" MinWidth="1000"
 Background="#F3F6FA" Foreground="#172D40" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" PreviewKeyDown="MainWindow_PreviewKeyDown">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="#D6DCE2" BorderThickness="0,0,1,0">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="14,18,14,10">
     <Image Source="{StaticResource GrangesStacked}" Stretch="Uniform" Height="90" Margin="8,0,8,18" AutomationProperties.Name="Gränges"/>
     <TextBlock Text="Safety Gate" Foreground="#F2F7FB" FontWeight="Bold" FontSize="19"/><TextBlock Text="Support" FontSize="16" Foreground="#AEC4D3"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,12,0,0">
     <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Content="⌂   Find a unit" Click="HomeNav_Click"/>
     <Button x:Name="SystemsNav" Style="{StaticResource NavButton}" Content="☷   Selected unit" Click="SystemsNav_Click"/>
     <Button x:Name="ManualsNav" Style="{StaticResource NavButton}" Content="▤   Manuals" Click="ManualsNav_Click"/>
     <Button x:Name="PartsNav" Style="{StaticResource NavButton}" Content="⚙   Parts" Click="PartsNav_Click"/>
     <Button Style="{StaticResource NavButton}" Content="Support library" Click="SupportLibrary_Click"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="16,10,12,18">
     <TextBlock x:Name="ConnectionText" FontSize="12" TextWrapping="Wrap"/>
     <Button x:Name="SetupButton" Content="Set Up Shared Data" Click="SetupSharedData_Click" Visibility="Collapsed" Padding="8,5" Margin="0,8,0,0"/>
     <TextBlock Text="v7.2.0" Foreground="#999" FontSize="10" Margin="0,8,0,0"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Column="1" Margin="22">
   <!-- HOME -->
   <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="930" HorizontalAlignment="Stretch">
     <DockPanel Margin="0,0,0,14">
      <Image Source="{StaticResource GrangesHorizontal}" Width="200" Height="52" Stretch="Uniform" DockPanel.Dock="Right" Margin="20,0,0,0" AutomationProperties.Name="Gränges"/>
      <StackPanel><TextBlock Text="Which unit are you working on?" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Find it by asset number, location, or photograph. Select its photo to continue." Foreground="#536E81" FontSize="15" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
     </DockPanel>
     <TextBlock Text="Search units" FontWeight="SemiBold" Margin="0,4,0,5"/>
     <TextBox x:Name="UnitSearchBox" MinHeight="46" FontSize="18" TextChanged="UnitSearch_Changed" KeyDown="UnitSearch_KeyDown" ToolTip="Asset number, unit, location, model or description" AutomationProperties.Name="Search units by asset number or location"/>
     <WrapPanel Margin="0,12,0,8"><Button x:Name="AllAreasButton" Content="All areas" Click="AllAreas_Click"/><WrapPanel x:Name="HomeCategoryPanel"/></WrapPanel>
     <TextBlock x:Name="GalleryStatusText" Text="Loading units…" Foreground="#536E81" TextWrapping="Wrap" Margin="4,0,0,12"/>
     <ItemsControl x:Name="UnitGallery"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button Click="UnitCard_Click" Tag="{Binding Unit}" HorizontalContentAlignment="Stretch" Padding="12" Margin="0,0,12,16" AutomationProperties.Name="{Binding Title}">
        <StackPanel>
         <Border Background="#EDF1F4" CornerRadius="8" Height="280" Padding="4"><Grid>
          <Image Source="{Binding Photo}" Stretch="Uniform" AutomationProperties.Name="{Binding Title}"/>
          <TextBlock Text="{Binding PhotoMessage}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#61788A" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Photo}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers><Setter Property="Visibility" Value="Collapsed"/></Style></TextBlock.Style></TextBlock>
         </Grid></Border>
         <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,12,4,4"/>
         <TextBlock Text="{Binding Location}" TextWrapping="Wrap" Foreground="#536E81" Margin="4,0,4,6"/>
         <TextBlock Text="Open this unit →" FontWeight="SemiBold" Foreground="#176B87" Margin="4,6,4,2"/>
        </StackPanel>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock x:Name="GalleryEmptyText" Text="No matching units. Try another asset number or select All areas." TextWrapping="Wrap" Margin="4,20" Visibility="Collapsed" FontSize="18"/>
     <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,18"><Button x:Name="PreviousUnitsButton" Content="← Previous units" Click="PreviousUnits_Click"/><TextBlock x:Name="GalleryPageText" VerticalAlignment="Center" Margin="14,0"/><Button x:Name="NextUnitsButton" Content="More units →" Click="NextUnits_Click"/></WrapPanel>
     <TextBlock x:Name="HomeSubtitleText" Foreground="#555" FontSize="15" Margin="0,4,0,10" TextWrapping="Wrap"/>

     <GroupBox Header="Search everything">
      <StackPanel Margin="12">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="GlobalSearchBox" Height="38" FontSize="16" VerticalContentAlignment="Center" ToolTip="Try: scanner, manual, asset 1226, drawing, part number..." TextChanged="GlobalSearchBox_TextChanged" KeyDown="GlobalSearchBox_KeyDown"/>
        <Button Grid.Column="1" Content="Search" Click="GlobalSearch_Click" Padding="22,7"/>
       </Grid>
       <ListBox x:Name="GlobalSearchResults" Margin="0,8,0,0" MaxHeight="300" MouseDoubleClick="GlobalSearchResults_DoubleClick" Visibility="Collapsed">
        <ListBox.ItemTemplate>
         <DataTemplate>
          <StackPanel Margin="4,5" MaxWidth="820">
           <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Subtitle}" Foreground="#666" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
       <TextBlock TextWrapping="Wrap" x:Name="SearchHintText" Foreground="#666" Margin="4,5,0,0" Text="Start typing to search systems, notes, drawings, manuals, configs, and parts."/>
      </StackPanel>
     </GroupBox>



     <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <GroupBox Header="Quick help" Grid.Column="0"><StackPanel x:Name="QuickHelpPanel" Margin="8"/></GroupBox>
      <GroupBox Header="Basic troubleshooting" Grid.Column="2"><StackPanel x:Name="TroubleshootingPanel" Margin="8"/></GroupBox>
     </Grid>
    </StackPanel>
   </ScrollViewer>

   <!-- The unit workspace keeps the selected identity while tools open. -->
   <Grid x:Name="SystemsView" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14"><Button x:Name="ChangeUnitButton" Content="← Change unit" Click="HomeNav_Click" DockPanel.Dock="Right"/><StackPanel><TextBlock x:Name="UnitTitleText" Text="Select a unit" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="UnitAreaText" Foreground="#536E81" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel>
    <ScrollViewer x:Name="UnitWorkspaceScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <StackPanel x:Name="NoUnitPanel" Margin="24"><TextBlock Text="Select a unit to see its photo, files and troubleshooting." FontSize="21" TextWrapping="Wrap"/><Button Content="Find a unit" Click="HomeNav_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel>
     <StackPanel x:Name="UnitDetailPanel" Visibility="Collapsed">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
       <StackPanel>
        <Button x:Name="EnlargePhotoButton" Click="EnlargePhoto_Click" Padding="8" Margin="0" HorizontalContentAlignment="Stretch" ToolTip="Open a large, uncropped view of this unit’s photos">
         <Border Background="#E9EEF2" Height="430" CornerRadius="8"><Grid><Image x:Name="GateImage" Stretch="Uniform"/><TextBlock x:Name="UnitPhotoMessage" Text="Loading identification photo…" TextWrapping="Wrap" TextAlignment="Center" Foreground="#61788A" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Border>
        </Button>
        <Button Content="Enlarge / browse photos" Click="EnlargePhoto_Click" HorizontalAlignment="Left" Margin="0,8,0,14"/>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <TextBlock Text="How can we help?" FontSize="22" FontWeight="SemiBold" Margin="4,0,0,12"/>
        <Button x:Name="TroubleshootButton" Content="Troubleshoot" Click="TroubleshootSimple_Click" Style="{StaticResource PrimaryButton}" MinHeight="56" HorizontalContentAlignment="Left"/>
        <Button x:Name="FilesButton" Content="Files &amp; drawings" Tag="all" Click="FindFiles_Click" MinHeight="56" HorizontalContentAlignment="Left"/>
        <TextBlock Text="Device tools" Foreground="#61788A" FontWeight="SemiBold" Margin="4,22,0,6"/>
        <Button x:Name="LightColumnButton" Content="Light column" Click="LightColumn_Click" MinHeight="52" HorizontalContentAlignment="Left" ToolTip="Read, compare or upload this unit’s approved Siemens light configuration"/>
        <Button x:Name="ScannerButton" Content="Hokuyo scanner · USB status" Click="Scanner_Click" MinHeight="52" HorizontalContentAlignment="Left" ToolTip="Read UAM scanner status or look up a display code"/>
        <Button x:Name="PlcButton" Content="PLC" Click="Plc_Click" MinHeight="52" HorizontalContentAlignment="Left" ToolTip="PLC information and files shared by every unit of this asset"/>
       </StackPanel>
      </Grid>
      <Expander Header="Shared notes" Margin="0,20,0,10"><StackPanel><TextBox x:Name="SharedNotesBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="100" MaxHeight="180" TextChanged="SharedNotesBox_TextChanged"/><TextBlock x:Name="SharedNotesStatusText" Text="Shared notes auto-save." Foreground="#61788A" FontSize="12" Margin="2,6,0,0"/></StackPanel></Expander>
      <Expander Header="Unit details &amp; other resources" Margin="0,10"><StackPanel Margin="4,12">        <TextBlock x:Name="AssetInfoText" FontSize="15" TextWrapping="Wrap"/>
        <TextBlock x:Name="UnitInfoText" FontSize="15" TextWrapping="Wrap" Margin="0,4"/>
        <TextBlock x:Name="TypeInfoText" TextWrapping="Wrap" Foreground="#536E81"/>
        <TextBlock x:Name="ModelInfoText" TextWrapping="Wrap" Foreground="#536E81" Margin="0,4"/>
        <TextBlock x:Name="LocationInfoText" TextWrapping="Wrap" Foreground="#536E81"/>
<WrapPanel x:Name="SystemResourcePanel" Margin="0,12"/></StackPanel></Expander>
     </StackPanel>
     <Expander Header="Browse by asset and unit list" Margin="0,20,0,8"><StackPanel>
      <Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="AreaBox" SelectionChanged="AreaBox_SelectionChanged"/><TextBox x:Name="SystemSearchBox" Grid.Column="1" TextChanged="SystemSearchBox_TextChanged" Margin="10,0,0,0" ToolTip="Search within this area"/></Grid>
      <Grid Height="230"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox x:Name="AssetList" DisplayMemberPath="Display" SelectionChanged="AssetList_SelectionChanged"/><ListBox x:Name="UnitList" Grid.Column="1" DisplayMemberPath="UnitDisplay" Margin="10,0,0,0" SelectionChanged="UnitList_SelectionChanged"/></Grid>
     </StackPanel></Expander>
    </StackPanel></ScrollViewer>
   </Grid>

   <!-- MANUALS -->
   <Grid x:Name="ManualsView" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Manuals" FontSize="28" FontWeight="Bold"/>
    <StackPanel Grid.Row="1" Margin="0,8,0,12">
     <TextBlock x:Name="ManualsIntroText" Foreground="#555" TextWrapping="Wrap"/>
     <TextBox x:Name="ManualSearchBox" Height="36" FontSize="16" Margin="0,10,0,0" VerticalContentAlignment="Center" TextChanged="ManualSearchBox_TextChanged" ToolTip="Search manual file names"/>
    </StackPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ListBox x:Name="ManualList" DisplayMemberPath="Name" MouseDoubleClick="ManualList_DoubleClick"/>
     <StackPanel Grid.Column="1" Margin="12,0,0,0"><Button Content="Open" Click="OpenManual_Click"/><Button Content="Open Manuals Folder" Click="OpenManualFolder_Click"/></StackPanel>
    </Grid>
   </Grid>

   <!-- PARTS -->
   <Grid x:Name="PartsView" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Parts" FontSize="28" FontWeight="Bold"/>
    <StackPanel Grid.Row="1" Margin="0,8,0,12">
     <TextBlock x:Name="PartsIntroText" Foreground="#555" TextWrapping="Wrap"/>
     <TextBox x:Name="PartSearchBox" Height="36" FontSize="16" Margin="0,10,0,0" VerticalContentAlignment="Center" TextChanged="PartSearchBox_TextChanged" ToolTip="Search part number, description, manufacturer, keyword, or related asset"/>
    </StackPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ListBox x:Name="PartList" DisplayMemberPath="Display" SelectionChanged="PartList_SelectionChanged"/>
     <ScrollViewer Grid.Column="2"><StackPanel>
      <TextBlock x:Name="PartTitleText" FontSize="22" FontWeight="SemiBold" Text="Select a part."/>
      <TextBlock x:Name="PartManufacturerText" Foreground="#555" Margin="0,5,0,0"/>
      <TextBlock x:Name="PartRelatedText" Foreground="#555" Margin="0,5,0,0" TextWrapping="Wrap"/>
      <TextBlock x:Name="PartNotesText" Margin="0,12,0,0" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,14,0,0"><Button Content="Open Part Document" Click="OpenPartDocument_Click"/><Button Content="Open Storeroom Database" Click="OpenStoreroom_Click"/><Button Content="Check Storeroom for Selected Part" Click="CheckStoreroom_Click"/></WrapPanel>
      <TextBlock Text="Storeroom result" FontWeight="SemiBold" Margin="4,16,0,4"/>
      <Border BorderBrush="#CCC" BorderThickness="1" Padding="10"><TextBlock x:Name="StoreroomResultText" Text="No lookup performed." TextWrapping="Wrap"/></Border>
     </StackPanel></ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
