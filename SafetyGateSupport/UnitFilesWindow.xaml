<Window x:Class="SafetyGateSupport.UnitFilesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Unit files" Width="1020" Height="690" MinWidth="800" MinHeight="550" Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="The right file for this unit" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="UnitText" TextWrapping="Wrap" Margin="0,6,0,16" Foreground="#536E81"/></StackPanel>
  <StackPanel Grid.Row="1"><WrapPanel x:Name="FilterPanel"><Button Content="All files" Tag="all" Click="Filter_Click"/><Button Content="Light configs" Tag="light" Click="Filter_Click"/><Button Content="Drawings" Tag="drawing" Click="Filter_Click"/><Button Content="Scanner configs" Tag="scanner" Click="Filter_Click"/><Button Content="Manuals" Tag="manual" Click="Filter_Click"/></WrapPanel><TextBlock Text="Search this unit’s files" Foreground="#536E81" Margin="4,10,0,0"/><TextBox x:Name="FileSearchBox" TextChanged="Search_Changed" Margin="4,8" ToolTip="Search these assigned files by name"/><TextBlock Text="Current assigned files only. Confirm the asset and unit before using a configuration." Foreground="#536E81" TextWrapping="Wrap" Margin="4,2,4,12"/></StackPanel>
  <ListBox x:Name="FileList" Grid.Row="2" MouseDoubleClick="File_DoubleClick" SelectionChanged="Selection_Changed"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Category}" Foreground="#536E81" Margin="0,4,0,0"/><TextBlock Text="{Binding Path}" FontSize="11" Foreground="#6C8090" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
  <StackPanel Grid.Row="3"><TextBlock x:Name="StatusText" Text="Loading current files…" TextWrapping="Wrap" Margin="4,12"/><WrapPanel><Button x:Name="OpenButton" Content="Open selected file" Click="Open_Click" IsEnabled="False"/><Button x:Name="FolderButton" Content="Show in folder" Click="Folder_Click" IsEnabled="False"/><Button x:Name="ColumnButton" Content="Check / configure light" Style="{StaticResource PrimaryButton}" Click="Column_Click"/><Button Content="Import / assign files" Click="Resources_Click"/><Button Content="Close" Click="Close_Click"/></WrapPanel></StackPanel>
 </Grid>
</Window>
