<Window x:Class="SafetyGateSupport.ResourceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Resource" Height="560" Width="820" MinHeight="480" MinWidth="700"
 Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <StackPanel>
   <TextBlock x:Name="ResourceTitleText" FontSize="25" FontWeight="Bold"/>
   <TextBlock x:Name="SystemText" Foreground="#555" Margin="0,3,0,0"/>
  </StackPanel>

  <Border Grid.Row="1" Background="#F4F7FA" BorderBrush="#D6DCE2" BorderThickness="1" Padding="12" Margin="0,14,0,10">
   <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Foreground="#444"/>
  </Border>

  <GroupBox Grid.Row="2" Header="Files">
   <Grid Margin="8">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ListBox x:Name="FileList" MouseDoubleClick="FileList_DoubleClick">
     <ListBox.ItemTemplate>
      <DataTemplate>
       <Grid Margin="3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="1" Text="{Binding Modified}" Foreground="#666"/>
        <TextBlock Grid.Column="2" Text="{Binding Size}" Foreground="#666" HorizontalAlignment="Right"/>
       </Grid>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="EmptyText" Grid.Row="0" Text="No files have been added yet." Foreground="#777" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
     <Button Content="Open Selected" Click="OpenSelected_Click"/>
     <Button Content="Open Current Folder" Click="OpenCurrentFolder_Click"/>
     <Button x:Name="UpdateButton" Content="Upload / Update Drawing" Click="Update_Click" Visibility="Collapsed"/>
     <Button x:Name="ReplaceFileButton" Content="Replace selected file…" Click="ReplaceFile_Click" Visibility="Collapsed"/>
     <Button x:Name="FileUnitsButton" Content="Applies to units…" Click="FileUnits_Click" Visibility="Collapsed"/>
     <Button Content="View Archive" Click="OpenArchive_Click"/>
     <Button x:Name="UamDiagnosticsButton" Content="Check UAM scanner…" Click="UamDiagnostics_Click" Visibility="Collapsed"/>
     <Button x:Name="SignalColumnButton" Content="Check / configure column…" Click="SignalColumn_Click" Visibility="Collapsed"/>
     <Button x:Name="LaunchButton" Click="Launch_Click" Visibility="Collapsed"/>
    </WrapPanel>
   </Grid>
  </GroupBox>

  <DockPanel Grid.Row="3" Margin="0,12,0,0">
   <TextBlock x:Name="StatusText" Foreground="#666" VerticalAlignment="Center" TextWrapping="Wrap"/>
   <Button Content="Close" Click="Close_Click" DockPanel.Dock="Right" Padding="24,8"/>
  </DockPanel>
 </Grid>
</Window>
