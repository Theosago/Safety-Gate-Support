<Window x:Class="SafetyGateSupport.AdminWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Safety Gate Support - Plant setup" Height="780" Width="1260" MinHeight="640" MinWidth="1050" WindowStartupLocation="CenterOwner">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Plant setup" FontSize="26" FontWeight="Bold"/>
   <TextBlock Text="Start with one useful unit. Add its photo, one approved document and one common fix, then try the operator view before expanding to the rest of the plant." Foreground="{DynamicResource ThemeForeground555555}" TextWrapping="Wrap"/>
   <WrapPanel Margin="0,8,0,0"><CheckBox x:Name="AdvancedSetupCheck" Content="Show advanced tools" Click="AdvancedSetup_Click"/><TextBlock x:Name="SetupTaskText" Text="Start here shows the recommended path. Existing data stays available in the editors." TextWrapping="Wrap" Margin="16,0,0,0"/></WrapPanel>
   <TextBlock x:Name="StartGuideStatus" TextWrapping="Wrap" FontWeight="SemiBold"/>
  </StackPanel>
  <TabControl x:Name="SetupTabs" Grid.Row="1" Margin="0,14,0,10" SelectionChanged="SetupTabs_SelectionChanged">


   <TabItem x:Name="StartSetupTab" Header="Start here"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20" MaxWidth="920" HorizontalAlignment="Left">
    <TextBlock Text="Make one unit useful first" FontSize="25" FontWeight="SemiBold"/>
    <TextBlock Text="A pilot succeeds when someone can identify the unit from its photo, find the correct document, and recognize a common broken part without asking you. Hardware programming and live stockroom access can come later." TextWrapping="Wrap" Margin="0,8,0,16"/>
    <GroupBox Header="1 · Connect a library, or start a new plant"><StackPanel Margin="12">
     <TextBlock Text="A library is a folder containing this plant’s equipment, photos and guidance. A local folder works for a pilot; use a shared location when other computers need the same content." TextWrapping="Wrap"/>
     <TextBlock Text="Library folder" Margin="0,10,0,3"/><TextBox x:Name="StartLibraryPathBox" MinHeight="34"/><Button Content="Choose folder…" Click="StartChooseFolder_Click" HorizontalAlignment="Left"/>
     <Button x:Name="ConnectLibraryButton" Content="Use this existing library" Click="ConnectLibrary_Click" HorizontalAlignment="Left"/>
     <Separator Margin="0,10"/><TextBlock Text="For a new plant: choose an empty folder and name its first area. This creates no Huntingdon equipment or parts." TextWrapping="Wrap"/>
     <TextBlock Text="First area (for example, Packaging)" Margin="0,8,0,3"/><TextBox x:Name="StartAreaBox" MinHeight="34"/>
     <Button x:Name="CreateBlankLibraryButton" Content="Create blank plant library" Click="CreateBlankLibrary_Click" HorizontalAlignment="Left"/>
     <TextBlock x:Name="StartLibraryStatus" TextWrapping="Wrap" Margin="0,8"/>
    </StackPanel></GroupBox>
    <GroupBox Header="2 · Add the box and its unit"><StackPanel Margin="12"><TextBlock Text="An asset is the numbered gate or box. A unit is the individual assembly the operator selects. Add the asset number/location first, then a unit and an uncropped identification photo. Choose only equipment this unit actually has." TextWrapping="Wrap"/>
     <TextBlock x:Name="StartInventoryStatus" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8"/>
     <WrapPanel><Button x:Name="StartAddAssetButton" Content="Add an asset / box" Click="StartAddAsset_Click"/><Button x:Name="StartAddUnitButton" Content="Add a unit" Click="StartAddUnit_Click"/><Button Content="Manage areas" Click="StartAreas_Click"/></WrapPanel>
     <TextBlock Text="Pilot unit for the next steps" Margin="0,10,0,3"/><ComboBox x:Name="PilotUnitBox" DisplayMemberPath="AdminDisplay" MinHeight="34"/>
     <Button Content="Edit this unit and photo" Click="StartEditPilot_Click" HorizontalAlignment="Left"/>
    </StackPanel></GroupBox>
    <GroupBox Header="3 · Give the operator something useful"><StackPanel Margin="12">
     <TextBlock Text="Add one approved PDF to the pilot unit. Then add a photo of a common failure and clear fix instructions. Parts can be added when you have stockroom access or reviewed details; they are optional for the first pilot." TextWrapping="Wrap"/>
     <WrapPanel><Button Content="Attach a PDF to the pilot unit…" Click="StartAttachPdf_Click"/><Button x:Name="StartProblemButton" Content="Add a Common Problem" Click="StartProblem_Click"/><Button Content="Add parts" Click="StartParts_Click"/></WrapPanel>
     <TextBlock x:Name="StartContentStatus" TextWrapping="Wrap" Margin="0,8"/>
    </StackPanel></GroupBox>
    <GroupBox Header="4 · Try the operator’s job"><StackPanel Margin="12"><TextBlock Text="Save your edits, then leave Setup and test the pilot: identify it from the photo, open its PDF, find the fix from the problem picture, and return to the same unit. Ask a maintenance colleague to repeat this without coaching. Record what confuses them before adding more units." TextWrapping="Wrap"/>
     <Button x:Name="StartOperatorButton" Content="Open the saved pilot in operator view" Click="StartOperator_Click" HorizontalAlignment="Left" Margin="0,10"/>
     <TextBlock Text="For phone-only crews, start with a printed photo guide and offline text QR label. An approved company-owned document link can be added later; a phone QR cannot grant access to Q:." TextWrapping="Wrap"/>
     <Button Content="Phone guides and QR labels" Click="StartPhoneGuides_Click" HorizontalAlignment="Left"/>
    </StackPanel></GroupBox>
   </StackPanel></ScrollViewer></TabItem>

   <TabItem x:Name="UnitsSetupTab" Header="Gates &amp; Units">
    <Grid Margin="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="120"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <ComboBox x:Name="GateAreaFilterBox" Height="34" SelectionChanged="GateAreaFilterBox_SelectionChanged"/>
      <WrapPanel Grid.Row="1" Margin="0,6,0,6"><Button Content="+ New Gate" Click="NewGate_Click"/><Button Content="Delete Gate" Click="DeleteGate_Click"/></WrapPanel>
      <ListBox x:Name="GateList" Grid.Row="2" DisplayMemberPath="Display" SelectionChanged="GateList_SelectionChanged"/>
     </Grid>
     <Grid Grid.Column="1" Margin="10,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel><Button Content="+ Unit" Click="NewUnit_Click"/><Button Content="Delete" Click="DeleteUnit_Click"/></WrapPanel>
      <ListBox x:Name="UnitListAdmin" Grid.Row="1" Margin="0,8,0,0" DisplayMemberPath="UnitDisplay" SelectionChanged="UnitListAdmin_SelectionChanged"/>
     </Grid>
     <ScrollViewer x:Name="GateUnitEditorScroll" Grid.Column="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <GroupBox Header="Selected unit" Margin="0,14,0,0"><Grid Margin="10">
       <Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="Unit Number" VerticalAlignment="Center"/><TextBox x:Name="UnitNumberBox" Grid.Column="1" Margin="3"/>
       <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0"><TextBlock Text="Equipment on this unit" FontWeight="SemiBold"/><WrapPanel><CheckBox x:Name="UnitHasSignalColumnCheck" Content="Signal column" Margin="0,8,20,0"/><CheckBox x:Name="UnitHasScannerCheck" Content="Safety scanner" Margin="0,8,0,0"/></WrapPanel><TextBlock Text="Uncheck equipment this unit does not have. Files are retained; the unit-page action is hidden." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ThemeForeground61788A}" Margin="0,6,0,0"/></StackPanel>
       <TextBlock Grid.Row="2" Text="Identification Photo" VerticalAlignment="Center"/><StackPanel Grid.Row="2" Grid.Column="1"><WrapPanel><Button Content="Choose Photo..." Click="ChoosePhoto_Click"/><Button Content="Paste Image" Click="PastePhoto_Click" Margin="6,0,0,0"/></WrapPanel><TextBlock x:Name="UnitPhotoText" TextWrapping="Wrap" FontSize="12" Margin="4,4,0,0"/></StackPanel>
       <Border x:Name="UnitPhotoPreviewBorder" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="10" Background="{DynamicResource ThemeBackgroundF7F9FB}" BorderBrush="{DynamicResource ThemeBorderBrushD6DCE2}" BorderThickness="1" CornerRadius="4" Focusable="True" AllowDrop="True" PreviewKeyDown="UnitPhotoPreviewBorder_PreviewKeyDown" MouseLeftButtonDown="UnitPhotoPreviewBorder_MouseLeftButtonDown" DragOver="UnitPhotoPreviewBorder_DragOver" Drop="UnitPhotoPreviewBorder_Drop" ToolTip="Click this preview and press Ctrl+V to paste an image, or drag an image file here.">
        <StackPanel>
         <TextBlock Text="Identification photo preview" FontWeight="SemiBold" Margin="0,0,0,2"/>
         <TextBlock Text="Click the preview and press Ctrl+V, use Paste Image, or drag and drop an image file." Foreground="{DynamicResource ThemeForeground666666}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
         <Border Height="260" Background="{DynamicResource ThemeBackgroundECEFF2}" BorderBrush="{DynamicResource ThemeBorderBrushCDD3D9}" BorderThickness="1">
          <Grid><Image x:Name="UnitPhotoPreview" Stretch="Uniform"/><TextBlock Text="{Binding Text, ElementName=UnitPhotoPreviewStatus}" TextWrapping="Wrap" TextAlignment="Center" Margin="20" Foreground="{DynamicResource ThemeForeground61788A}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=UnitPhotoPreview}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
         </Border>
         <TextBlock x:Name="UnitPhotoPreviewStatus" Text="Choose, paste, or drop a photo to preview it before saving the unit." Foreground="{DynamicResource ThemeForeground666666}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
       </Border>
      </Grid></GroupBox>
      <Expander Header="Phone guide / QR label (optional)" Margin="0,10"><StackPanel>
       <TextBlock Text="Offline text works without accounts or internet. Photos belong in the printable guide. If an approved document link becomes available, paste it below; that link takes priority over offline text in the QR code." TextWrapping="Wrap"/>
       <TextBlock Text="Short offline instructions (700 characters maximum)" Margin="0,8,0,3"/><TextBox x:Name="MobileOfflineBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="85" MaxLength="700"/>
       <TextBlock Text="Approved HTTPS document link (optional)" Margin="0,8,0,3"/><TextBox x:Name="MobileSupportUrlBox" TextWrapping="Wrap"/>
       <TextBlock Text="Save the unit, then use Export phone guides and QR labels under Shared Data / Software. Test any document link with a worker who has no employee account before fitting labels." TextWrapping="Wrap" Margin="0,6"/>
      </StackPanel></Expander>
      <WrapPanel><Button x:Name="SaveUnitButton" Content="Save Unit" Click="SaveUnit_Click" Padding="18,8"/><Button Content="Next: pilot checklist" Click="ReturnStart_Click"/></WrapPanel>
      <Expander x:Name="GateInformationExpander" Header="Asset / box information" Margin="0,16,0,0"><StackPanel>      <GroupBox Header="Asset / box information — shared by its units"><Grid Margin="10">
       <Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="Area" VerticalAlignment="Center"/><ComboBox x:Name="GateAreaBox" Grid.Column="1" Margin="3"/>
       <TextBlock Grid.Row="1" Text="Asset / box number" VerticalAlignment="Center"/><TextBox x:Name="GateAssetBox" Grid.Row="1" Grid.Column="1" Margin="3"/>
       <TextBlock Grid.Row="2" Text="Location / description" VerticalAlignment="Center"/><TextBox x:Name="GateLocationBox" Grid.Row="2" Grid.Column="1" Margin="3"/>
       <Expander Grid.Row="3" Grid.ColumnSpan="2" Header="Manufacturer, search terms and PLC details (optional)" Margin="0,10"><StackPanel>
        <TextBlock Text="Manufacturer / system"/><TextBox x:Name="GateManufacturerBox" Margin="0,3,0,8"/>
        <TextBlock Text="Model"/><TextBox x:Name="GateModelBox" Margin="0,3,0,8"/>
        <TextBlock Text="Equipment type"/><TextBox x:Name="GateTypeBox" Margin="0,3,0,8"/>
        <TextBlock Text="Search keywords"/><TextBox x:Name="GateKeywordsBox" Margin="0,3,0,8"/>
        <TextBlock Text="PLC address / IP"/><TextBox x:Name="PlcAddressBox" Margin="0,3,0,8"/>
        <TextBlock Text="PLC model"/><TextBox x:Name="PlcModelBox" Margin="0,3,0,8"/>
        <TextBlock Text="PLC notes"/><TextBox x:Name="PlcNotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" Margin="0,3"/>
       </StackPanel></Expander>
      </Grid></GroupBox>
      <WrapPanel><Button x:Name="SaveGateButton" Content="Save Gate Information" Click="SaveGate_Click" Padding="18,8"/><Button Content="Next: add a unit to this asset" Click="NewUnit_Click"/></WrapPanel>
</StackPanel></Expander>
      <Border Background="{DynamicResource ThemeBackgroundF4F7FA}" BorderBrush="{DynamicResource ThemeBorderBrushD6DCE2}" BorderThickness="1" Padding="10" Margin="0,14,0,0">
       <TextBlock Text="Drawings and other resources are configured on the Buttons / Resources tab. A single resource can be linked to multiple units, so paired units can share the exact same drawing and archive." TextWrapping="Wrap" Foreground="{DynamicResource ThemeForeground444444}"/>
      </Border>
     </StackPanel></ScrollViewer>
    </Grid>
   </TabItem>

   <TabItem x:Name="ResourcesSetupTab" Header="Buttons / Resources" Visibility="Collapsed">
    <Grid Margin="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <ComboBox x:Name="ResourceGateBox" Height="34" DisplayMemberPath="Display" SelectionChanged="ResourceGateBox_SelectionChanged"/>
      <WrapPanel Grid.Row="1" Margin="0,6"><Button Content="+ New Button" Click="NewResource_Click"/><Button Content="Delete" Click="DeleteResource_Click"/></WrapPanel>
      <ListBox x:Name="ResourceList" Grid.Row="2" DisplayMemberPath="AdminDisplay" SelectionChanged="ResourceList_SelectionChanged"/>
     </Grid>
     <ScrollViewer Grid.Column="2"><StackPanel>
      <TextBlock Text="Button / resource" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Button label" Margin="0,8,0,3"/><TextBox x:Name="ResourceLabelBox" Height="34"/>
      <TextBlock Text="Type" Margin="0,8,0,3"/><ComboBox x:Name="ResourceKindBox" Height="34" SelectionChanged="ResourceKindBox_SelectionChanged"/>
      <TextBlock Text="Show on these units" Margin="0,10,0,3"/>
      <ListBox x:Name="ResourceUnitsList" Height="120" DisplayMemberPath="UnitDisplay" SelectionMode="Multiple"/>
      <TextBlock Text="Select more than one unit to make one shared button/resource. Example: Units 4 and 5 can both point to one Electrical Drawings folder. Leave all units unselected to show the button on every unit under the gate." Foreground="{DynamicResource ThemeForeground666666}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <WrapPanel Margin="0,8,0,0"><CheckBox x:Name="ResourceVisibleCheck" Content="Visible" IsChecked="True" Margin="4,5,18,5"/><CheckBox x:Name="ResourceUploadCheck" Content="Regular users can upload / update files" Margin="4,5,18,5"/></WrapPanel>
      <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="Archive rule"/><ComboBox x:Name="ResourceArchiveBox" Height="34"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Launch software"/><ComboBox x:Name="ResourceLaunchBox" Height="34"/></StackPanel>
      </Grid>
      <TextBlock Text="Managed folder / target" Margin="0,8,0,3"/><TextBox x:Name="ResourceTargetBox" Height="34" ToolTip="Managed Files: relative folder (leave blank for automatic). Folder: path. URL: http://..."/>
      <TextBlock Text="Description" Margin="0,8,0,3"/><TextBox x:Name="ResourceDescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/>
      <TextBlock Text="Search keywords" Margin="0,8,0,3"/><TextBox x:Name="ResourceKeywordsBox" Height="34"/>
      <TextBlock Text="Sort order" Margin="0,8,0,3"/><TextBox x:Name="ResourceSortBox" Width="100" Height="34" HorizontalAlignment="Left"/>
      <WrapPanel Margin="0,10,0,0"><Button Content="Save Button / Resource" Click="SaveResource_Click"/><Button Content="Open Current Folder" Click="OpenResourceCurrent_Click"/><Button Content="Open Archive" Click="OpenResourceArchive_Click"/></WrapPanel>
     </StackPanel></ScrollViewer>
    </Grid>
   </TabItem>

   <TabItem x:Name="FlowsSetupTab" Header="Troubleshooting" Visibility="Collapsed">
    <Grid Margin="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="240"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel><Button Content="+ Flow" Click="NewFlow_Click"/><Button Content="Delete" Click="DeleteFlow_Click"/></WrapPanel>
      <ListBox x:Name="FlowListAdmin" Grid.Row="1" Margin="0,8,0,0" DisplayMemberPath="AdminDisplay" SelectionChanged="FlowListAdmin_SelectionChanged"/>
     </Grid>
     <Grid Grid.Column="1" Margin="10,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel><Button Content="+ Step" Click="NewNode_Click"/><Button Content="Delete" Click="DeleteNode_Click"/></WrapPanel>
      <ListBox x:Name="NodeListAdmin" Grid.Row="1" Margin="0,8,0,0" DisplayMemberPath="AdminDisplay" SelectionChanged="NodeListAdmin_SelectionChanged"/>
     </Grid>
     <ScrollViewer Grid.Column="3"><StackPanel>
      <TextBlock Text="Troubleshooting flow" FontSize="19" FontWeight="SemiBold"/>
      <TextBlock Text="Title" Margin="0,6,0,3"/><TextBox x:Name="FlowTitleBox" Height="34"/>
      <TextBlock Text="Keywords" Margin="0,6,0,3"/><TextBox x:Name="FlowKeywordsBox" Height="34"/>
      <TextBlock Text="Manufacturer filter (optional)" Margin="0,6,0,3"/><TextBox x:Name="FlowManufacturerBox" Height="34"/>
      <TextBlock Text="Specific gate (optional)" Margin="0,6,0,3"/><ComboBox x:Name="FlowGateBox" Height="34" DisplayMemberPath="Display" SelectionChanged="FlowGateBox_SelectionChanged"/>
      <Button Content="Save Flow" Click="SaveFlow_Click" HorizontalAlignment="Left" Margin="0,8,0,12"/>
      <Separator/>
      <TextBlock Text="Selected step" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,0"/>
      <TextBlock x:Name="NodeIdText" Foreground="{DynamicResource ThemeForeground777777}" Margin="0,3,0,5"/>
      <TextBlock Text="Question / heading"/><TextBox x:Name="NodePromptBox" Height="34"/>
      <TextBlock Text="Instructions" Margin="0,6,0,3"/><TextBox x:Name="NodeBodyBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"/>
      <WrapPanel Margin="0,6,0,0"><CheckBox x:Name="NodeTerminalCheck" Content="End of path" Margin="4"/><CheckBox x:Name="NodeStartCheck" Content="Starting step" Margin="16,4,4,4"/></WrapPanel>
      <TextBlock Text="Answer buttons" FontWeight="SemiBold" Margin="0,8,0,3"/>
      <TextBlock Text="One per line: Button text => next-step-ID. The step IDs are shown under each selected step." Foreground="{DynamicResource ThemeForeground666666}" TextWrapping="Wrap"/>
      <TextBox x:Name="NodeChoicesBox" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="90" VerticalScrollBarVisibility="Auto"/>
      <TextBlock Text="Linked resource buttons" FontWeight="SemiBold" Margin="0,8,0,3"/>
      <ListBox x:Name="NodeResourceList" Height="110" DisplayMemberPath="AdminDisplay" SelectionMode="Multiple"/>
      <Button Content="Save Step" Click="SaveNode_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
     </StackPanel></ScrollViewer>
    </Grid>
   </TabItem>

   <TabItem x:Name="HelpSetupTab" Header="Home / Help">
    <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel><Button Content="+ New Topic" Click="NewHelp_Click"/><Button x:Name="NewCommonProblemButton" Content="+ Common Problem" Click="NewCommonProblem_Click"/><Button Content="Delete" Click="DeleteHelp_Click"/></WrapPanel>
      <ListBox x:Name="HelpList" Grid.Row="1" Margin="0,8,0,0" DisplayMemberPath="AdminDisplay" SelectionChanged="HelpList_SelectionChanged"/>
     </Grid>
     <ScrollViewer Grid.Column="2"><StackPanel>
      <Expander Header="Home-page wording (optional)"><StackPanel>
      <TextBlock Text="Home text" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Home subtitle" Margin="0,8,0,3"/><TextBox x:Name="HomeSubtitleBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58"/>
      <TextBlock Text="Manuals intro" Margin="0,8,0,3"/><TextBox x:Name="ManualsIntroBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"/>
      <TextBlock Text="Parts intro" Margin="0,8,0,3"/><TextBox x:Name="PartsIntroBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"/>
      <Button Content="Save Home Text" Click="SaveSharedContent_Click" HorizontalAlignment="Left" Margin="0,8,0,16"/>
      <Separator/>
      </StackPanel></Expander>
      <TextBlock Text="Help / Common Problem" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,6"/>
      <TextBlock Text="Section"/><ComboBox x:Name="HelpSectionBox" Height="34"><ComboBoxItem Content="Quick Help"/><ComboBoxItem Content="Troubleshooting"/><ComboBoxItem Content="Common Problems"/></ComboBox>
      <TextBlock Text="Title" Margin="0,8,0,3"/><TextBox x:Name="HelpTitleBox" Height="34"/>
      <CheckBox x:Name="HelpVisibleCheck" Content="Show this entry to users" IsChecked="True" Margin="0,10"/>
      <TextBlock Text="Problem photos (optional)" Margin="0,8,0,3"/>
      <WrapPanel><Button Content="Add photos…" Click="ChooseHelpPhoto_Click"/><Button Content="Remove selected photo" Click="RemoveHelpPhoto_Click"/></WrapPanel>
      <ListBox x:Name="HelpPhotoList" DisplayMemberPath="Label" Height="90" SelectionChanged="HelpPhoto_SelectionChanged"/><Button Content="Use selected as cover" Click="CoverHelpPhoto_Click" HorizontalAlignment="Left"/><Image x:Name="HelpPhotoPreview" Height="160" Stretch="Uniform" HorizontalAlignment="Left"/>
      <TextBlock x:Name="HelpPhotoStatus" TextWrapping="Wrap"/>
      <TextBlock Text="How to recognize it and how to fix it" Margin="0,8,0,3"/><TextBox x:Name="HelpBodyBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="120"/>
      <TextBlock Text="Keywords" Margin="0,8,0,3"/><TextBox x:Name="HelpKeywordsBox" Height="34"/>
      <TextBlock Text="Sort order" Margin="0,8,0,3"/><TextBox x:Name="HelpSortBox" Height="34" Width="100" HorizontalAlignment="Left"/>
      <Button x:Name="SaveHelpButton" Content="Save Topic" Click="SaveHelp_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
     </StackPanel></ScrollViewer>
    </Grid>
   </TabItem>

   <TabItem x:Name="ManualsSetupTab" Header="Manuals" Visibility="Collapsed">
    <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel><Button Content="+ Manual" Click="NewManual_Click"/><Button Content="Delete" Click="DeleteManual_Click"/></WrapPanel>
      <ListBox x:Name="ManualListAdmin" Grid.Row="1" Margin="0,8,0,0" DisplayMemberPath="Display" SelectionChanged="ManualListAdmin_SelectionChanged"/>
     </Grid>
     <ScrollViewer Grid.Column="2"><StackPanel>
      <TextBlock Text="Title"/><TextBox x:Name="ManualTitleBox" Height="34"/>
      <TextBlock Text="Manufacturer" Margin="0,7,0,3"/><TextBox x:Name="ManualManufacturerBox" Height="34"/>
      <TextBlock Text="Model" Margin="0,7,0,3"/><TextBox x:Name="ManualModelBox" Height="34"/>
      <TextBlock Text="Keywords" Margin="0,7,0,3"/><TextBox x:Name="ManualKeywordsBox" Height="34"/>
      <TextBlock Text="Document" Margin="0,7,0,3"/><WrapPanel><Button Content="Choose / Replace File..." Click="ChooseManualFile_Click"/><TextBlock x:Name="ManualFileText" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel>
      <TextBlock Text="Applies to gates" FontWeight="SemiBold" Margin="0,9,0,3"/><ListBox x:Name="ManualGateAssignments" Height="120" DisplayMemberPath="Display" SelectionMode="Multiple"/>
      <TextBlock Text="Applies to specific units (optional)" FontWeight="SemiBold" Margin="0,9,0,3"/><ListBox x:Name="ManualUnitAssignments" Height="110" DisplayMemberPath="AdminDisplay" SelectionMode="Multiple"/>
      <TextBlock Text="Leave both assignment lists empty to make the manual global. Gate assignment applies it to every unit under that gate; unit assignment can be used for exceptions." Foreground="{DynamicResource ThemeForeground666666}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <WrapPanel Margin="0,10,0,0"><Button Content="Save Manual" Click="SaveManual_Click"/><Button Content="Open Document" Click="OpenManualAdmin_Click"/></WrapPanel>
     </StackPanel></ScrollViewer>
    </Grid>
   </TabItem>

   <TabItem x:Name="PartsSetupTab" Header="Parts">
    <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel><Button Content="+ Part" Click="NewPart_Click"/><Button Content="Delete" Click="DeletePart_Click"/></WrapPanel>
      <ListBox x:Name="AdminPartList" Grid.Row="1" Margin="0,8,0,0" SelectionChanged="AdminPartList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox>
     </Grid>
     <ScrollViewer Grid.Column="2"><StackPanel>
      <TextBlock Text="Add a part by Item ID" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="Choose the plant once, enter the stockroom Item ID, then import. Details and any supplied photo are saved to the shared library." TextWrapping="Wrap" Margin="0,6,0,12"/>
      <ComboBox x:Name="ImportPlantBox" DisplayMemberPath="Name" Height="34"/>
      <TextBlock Text="Item ID" Margin="0,10,0,4"/><TextBox x:Name="PartNumberBox" Height="38" FontSize="18" KeyDown="ImportItem_KeyDown"/>
      <Button x:Name="ImportItemButton" Content="Import from stockroom" Click="ImportItem_Click" HorizontalAlignment="Left" Margin="0,8"/>
      <TextBlock x:Name="ImportItemStatus" TextWrapping="Wrap" Margin="0,4,0,12"/>
      <Expander Header="Details / optional edits"><StackPanel>
      <TextBlock Text="Description"/><TextBox x:Name="PartDescriptionBox" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap"/>
      <TextBlock Text="Bin location" Margin="0,7,0,3"/><TextBox x:Name="PartBinBox" Height="34"/>

      <TextBlock Text="Reported quantity (snapshot)" Margin="0,7,0,3"/><TextBox x:Name="PartQuantityBox" Height="34"/>
      <TextBlock Text="Site" Margin="0,7,0,3"/><TextBox x:Name="PartSiteBox" Height="34"/>
      <TextBlock Text="Manufacturer" Margin="0,7,0,3"/><TextBox x:Name="PartManufacturerBox" Height="34"/>
      <TextBlock Text="Keywords" Margin="0,7,0,3"/><TextBox x:Name="PartKeywordsBox" Height="34"/>
      <TextBlock Text="Legacy / freeform related assets" Margin="0,7,0,3"/><TextBox x:Name="PartAssetsBox" Height="34"/>
      <TextBlock Text="Notes" Margin="0,7,0,3"/><TextBox x:Name="PartNotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="75"/>
      <TextBlock Text="Document" Margin="0,7,0,3"/><WrapPanel><Button Content="Choose / Replace Document..." Click="ChoosePartDocument_Click"/><TextBlock x:Name="PartDocumentText" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel>
      </StackPanel></Expander>
      <TextBlock Text="Applies to gates" FontWeight="SemiBold" Margin="0,9,0,3"/><ListBox x:Name="PartGateAssignments" Height="110" DisplayMemberPath="Display" SelectionMode="Multiple"/>
      <TextBlock Text="Applies to specific units (optional)" FontWeight="SemiBold" Margin="0,9,0,3"/><ListBox x:Name="PartUnitAssignments" Height="100" DisplayMemberPath="AdminDisplay" SelectionMode="Multiple"/>
      <TextBlock Text="Leave both assignment lists empty to make the part global." Foreground="{DynamicResource ThemeForeground666666}"/>
      <Button Content="Save Part" Click="SavePart_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
     </StackPanel></ScrollViewer>
    </Grid>
   </TabItem>

   <TabItem x:Name="AreasSetupTab" Header="Areas" Visibility="Collapsed">
    <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ListBox x:Name="AreaList" SelectionChanged="AreaList_SelectionChanged"/>
     <StackPanel Grid.Column="2"><TextBlock Text="Area name"/><TextBox x:Name="AreaNameBox" Height="34" Margin="0,4,0,8"/><WrapPanel><Button Content="Add" Click="AddArea_Click"/><Button x:Name="RenameAreaButton" Content="Rename" Click="RenameArea_Click"/><Button Content="Delete" Click="DeleteArea_Click"/></WrapPanel><TextBlock Text="An area cannot be deleted while gates are assigned to it." Foreground="{DynamicResource ThemeForeground666666}" TextWrapping="Wrap" Margin="4,12,0,0"/></StackPanel>
    </Grid>
   </TabItem>

   <TabItem x:Name="LibrarySetupTab" Header="Shared Data / Software">
    <ScrollViewer><StackPanel Margin="18" MaxWidth="820" HorizontalAlignment="Left">
     <TextBlock Text="Shared data location" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="Use Start here to connect or create a library. A local folder works for a pilot; computers sharing one plant’s content should use the same library." Foreground="{DynamicResource ThemeForeground555555}" Margin="0,4,0,6"/>
     <TextBox x:Name="SharedRootBox" Height="34"/><WrapPanel><Button Content="Choose Folder..." Click="ChooseSharedRoot_Click"/></WrapPanel>
     <Separator Margin="0,16"/>
     <Expander Header="Huntingdon sample data (training only)" Margin="0,10"><StackPanel><TextBlock Text="For a different plant, use Start here → Create blank plant library. Install this sample only when you intend to use the supplied Huntingdon equipment and parts." TextWrapping="Wrap"/><Button Content="Install Huntingdon sample data" Click="Initialize_Click" HorizontalAlignment="Left"/></StackPanel></Expander>
     <Button x:Name="OrganizeAssetFoldersButton" Content="Organize asset folders…" Click="OrganizeAssetFolders_Click" HorizontalAlignment="Left"/>
     <TextBlock Text="Preview a readable asset folder layout, merge identical copies, and review conflicting revisions before applying. Existing files and metadata are backed up." TextWrapping="Wrap" Foreground="{DynamicResource ThemeForeground61788A}" Margin="0,6,0,14"/>
     <TextBlock Text="Phone guides and QR labels" FontWeight="SemiBold" FontSize="17"/>
     <TextBlock Text="Export self-contained photo guides for printing or saving as PDF, plus labels for units with offline text or an approved document link. No server, login or internet is needed for text-only labels. Nothing is uploaded automatically." TextWrapping="Wrap" Margin="0,6"/>
     <CheckBox x:Name="ExportIncludeNotesCheck" Content="Include shared notes in the exported guides" Margin="0,6"/>
     <Button x:Name="ExportPhoneGuidesButton" Content="Export phone guides and QR labels…" Click="ExportPhoneGuides_Click" HorizontalAlignment="Left"/>
     <TextBlock x:Name="PhoneExportStatus" TextWrapping="Wrap"/>
     <Separator Margin="0,16"/>
     <TextBlock Text="Application distribution" FontWeight="SemiBold" FontSize="17"/>
     <TextBlock Text="Recommended: keep the published SafetyGateSupport.exe in Q:\SafetyGateSupport\Application and give users a shortcut to that master copy. This build does not self-modify or auto-update." Foreground="{DynamicResource ThemeForeground555555}" TextWrapping="Wrap" Margin="0,4,0,6"/>
     <Separator Margin="0,16"/>
     <TextBlock Text="Storeroom database" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="Choose the stockroom plant on the Parts page. Each computer remembers its own choice." Foreground="{DynamicResource ThemeForeground555555}" Margin="0,3,0,4"/><TextBlock Text="First-time stockroom setup on each PC:" FontWeight="SemiBold" Margin="0,10,0,4"/>
     <TextBlock Text="1. Install Microsoft Edge WebView2 Evergreen Runtime if it is missing.&#10;2. Connect to the plant network and open the stockroom in your browser. Confirm inventory access.&#10;3. In Parts, choose Huntingdon, Salisbury or Newport, then refresh stock. No shared-folder change is needed.&#10;4. Compare one known Item ID and its Available quantity with the stockroom. Zero means out of stock; unknown means the lookup has not been confirmed.&#10;5. If the check fails, save a stockroom report from the right panel. It contains inventory text; share it only with your support contact." TextWrapping="Wrap" Foreground="{DynamicResource ThemeForeground555555}" Margin="0,0,0,10"/>
     <TextBox x:Name="StoreroomUrlBox" Visibility="Collapsed"/><Button Content="Save Shared Content Settings" Click="SaveSharedContent_Click" HorizontalAlignment="Left"/>
     <Separator Margin="0,16"/>
     <Expander Header="Vendor software paths (optional)"><StackPanel>
     <TextBlock Text="Programming software on this computer" FontWeight="SemiBold" FontSize="17"/>
     <TextBlock Text="Siemens 8WD46 Configurator" Margin="0,10,0,3"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SiemensBox" Height="34"/><Button Grid.Column="1" Content="Browse..." Click="BrowseSiemens_Click"/></Grid>
     <TextBlock Text="UAM Project Designer" Margin="0,10,0,3"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="UamBox" Height="34"/><Button Grid.Column="1" Content="Browse..." Click="BrowseUam_Click"/></Grid>
     <Button Content="Save Local Software Paths" Click="SaveLocalSettings_Click" HorizontalAlignment="Left" Padding="18,8" Margin="0,12,0,0"/>
     </StackPanel></Expander>
    </StackPanel></ScrollViewer>
   </TabItem>

   <TabItem x:Name="AuditSetupTab" Header="Audit / History" Visibility="Collapsed">
    <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel><Button Content="Refresh" Click="RefreshAudit_Click"/><TextBlock Text="Recent setup and file changes. Shared notes are intentionally not logged on every autosave." VerticalAlignment="Center" Foreground="{DynamicResource ThemeForeground666666}" Margin="10,0,0,0"/></WrapPanel>
     <ListBox x:Name="AuditList" Grid.Row="1" Margin="0,8,0,0" DisplayMemberPath="Display"/>
    </Grid>
   </TabItem>

  </TabControl>
  <TextBlock x:Name="AdminStatusText" Grid.Row="2" Foreground="{DynamicResource ThemeForeground555555}" TextWrapping="Wrap"/>
 </Grid>
</Window>
