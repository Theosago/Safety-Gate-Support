      <UniformGrid Grid.Row="2" Columns="2" Margin="-4,6,-4,-4"><Button Content="+ New button" Click="NewResource_Click"/><Button Content="Delete" Click="DeleteResource_Click" Style="{StaticResource DangerButton}"/></UniformGrid>
     </Grid></Border>
     <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="Button label" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/><TextBox x:Name="ResourceLabelBox"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Type" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/><ComboBox x:Name="ResourceKindBox" SelectionChanged="ResourceKindBox_SelectionChanged"/></StackPanel>
