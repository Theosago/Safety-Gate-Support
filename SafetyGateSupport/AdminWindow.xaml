<Window x:Class="SafetyGateSupport.AdminWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Safety Gate Support - Plant setup" Height="820" Width="1320" MinHeight="640" MinWidth="1050" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
 <Window.Resources>
  <!-- Page layout helpers used by every setup section. -->
  <Style x:Key="Page" TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="Padding" Value="28,22,28,28"/></Style>
  <Style x:Key="PageHeading" TargetType="TextBlock" BasedOn="{StaticResource PageTitle}"><Setter Property="FontSize" Value="22"/></Style>
  <Style x:Key="ListCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="12"/></Style>
  <Style x:Key="ListHeading" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource InkMuted}"/><Setter Property="Margin" Value="4,2,0,8"/></Style>
  <Style x:Key="StepNumber" TargetType="Border"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,0,14,0"/></Style>
  <Style x:Key="StepNumberText" TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource AccentInk}"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="ActionRow" TargetType="WrapPanel"><Setter Property="Margin" Value="-4,12,0,0"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <!-- Header -->
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,14">
   <DockPanel>
    <Button x:Name="CancelPartImportButton" DockPanel.Dock="Right" Content="Cancel stockroom import" Click="CancelPartImport_Click" Visibility="Collapsed" Style="{StaticResource DangerButton}" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal">
     <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoft}" Margin="0,0,14,0"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="Plant setup" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Set up equipment, photos, documents and parts that everyone on the floor will use." Foreground="{DynamicResource InkMuted}" FontSize="13"/>
     </StackPanel>
    </StackPanel>
   </DockPanel>
  </Border>

  <!-- Guidance and status from the current task; hidden when there is nothing to say. -->
  <Border Grid.Row="1" Background="{DynamicResource AccentSoft}" Padding="24,9">
   <Border.Style><Style TargetType="Border"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=SetupTaskText}" Value=""/><Condition Binding="{Binding Text, ElementName=StartGuideStatus}" Value=""/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></Border.Style>
   <StackPanel Orientation="Horizontal">
    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentInk}" VerticalAlignment="Top" Margin="0,2,10,0"/>
    <StackPanel MaxWidth="1100">
     <TextBlock x:Name="SetupTaskText" TextWrapping="Wrap" Foreground="{DynamicResource Ink}"/>
     <TextBlock x:Name="StartGuideStatus" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource AccentInk}"/>
    </StackPanel>
   </StackPanel>
  </Border>

  <TabControl x:Name="SetupTabs" Grid.Row="2" Style="{StaticResource SideNavTabs}" SelectionChanged="SetupTabs_SelectionChanged">
   <TabControl.Tag>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="6,14,0,0" Margin="0,10,0,0">
     <StackPanel>
      <CheckBox x:Name="AdvancedSetupCheck" Content="Show advanced tools" Click="AdvancedSetup_Click"/>
      <TextBlock Style="{StaticResource HelpText}" Margin="27,4,0,0" Text="Manuals, areas, resource buttons, troubleshooting flows and history."/>
     </StackPanel>
    </Border>
   </TabControl.Tag>

   <!-- START HERE -->
   <TabItem x:Name="StartSetupTab" Header="Start here" Tag="&#xE7C1;">
    <ScrollViewer Style="{StaticResource Page}"><StackPanel MaxWidth="900" HorizontalAlignment="Left">
     <TextBlock Text="Start here" Style="{StaticResource PageHeading}"/>
     <TextBlock Style="{StaticResource PageSubtitle}" Text="Get one unit fully working first: a photo to recognise it, one approved PDF and one common fix. Then try it the way an operator would before adding the rest of the plant." Margin="0,4,0,20"/>

     <Border Style="{StaticResource Callout}" Margin="0,0,0,16">
      <DockPanel>
       <Button x:Name="TrySamplePilotButton" Content="Try the operator demo…" Click="TrySamplePilot_Click" DockPanel.Dock="Right" VerticalAlignment="Center"/>
       <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
        <TextBlock Text="New here? See what operators will use." FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource HelpText}" Text="The demo uses fictional data in its own window. Close it to come back here."/>
       </StackPanel>
      </DockPanel>
     </Border>

     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><DockPanel>
      <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" Style="{StaticResource StepNumberText}"/></Border>
      <StackPanel>
       <TextBlock Text="Connect a library, or start a new plant" Style="{StaticResource SectionTitle}"/>
       <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0" Text="The library is the folder holding this plant’s equipment, photos and documents, normally on the shared Q: drive so every PC sees the same content."/>
       <TextBlock Text="Library folder" Style="{StaticResource FieldLabel}"/>
       <DockPanel LastChildFill="True">
        <Button Content="Browse…" Click="StartChooseFolder_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
        <TextBox x:Name="StartLibraryPathBox" AutomationProperties.Name="Library folder"/>
       </DockPanel>
       <WrapPanel Style="{StaticResource ActionRow}"><Button x:Name="ConnectLibraryButton" Content="Use this existing library" Click="ConnectLibrary_Click" Style="{StaticResource PrimaryButton}"/></WrapPanel>
       <Expander Header="Starting a brand-new plant instead?" Margin="-6,12,0,0">
        <StackPanel>
         <TextBlock Style="{StaticResource HelpText}" Text="Browse to an empty folder above, name the first area, then create the library."/>
         <TextBlock Text="First area (for example, Packaging)" Style="{StaticResource FieldLabel}"/>
         <TextBox x:Name="StartAreaBox" AutomationProperties.Name="First plant area" MaxWidth="420" HorizontalAlignment="Stretch"/>
         <WrapPanel Style="{StaticResource ActionRow}"><Button x:Name="CreateBlankLibraryButton" Content="Create blank plant library" Click="CreateBlankLibrary_Click"/></WrapPanel>
        </StackPanel>
       </Expander>
       <TextBlock x:Name="StartLibraryStatus" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource InkMuted}"/>
      </StackPanel>
     </DockPanel></Border>

     <Border x:Name="PilotEquipmentStep" Style="{StaticResource Card}" Margin="0,0,0,14"><DockPanel>
      <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" Style="{StaticResource StepNumberText}"/></Border>
      <StackPanel>
       <TextBlock Text="Add the asset and its unit" Style="{StaticResource SectionTitle}"/>
       <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0" Text="An asset is the numbered gate or box on the floor. A unit is the assembly inside it that an operator picks. If the label shows no unit number, use Unit 1."/>
       <TextBlock x:Name="StartInventoryStatus" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0"/>
       <WrapPanel Style="{StaticResource ActionRow}"><Button x:Name="StartAddAssetButton" Content="Add an asset" Click="StartAddAsset_Click"/><Button Content="Manage areas" Click="StartAreas_Click" Style="{StaticResource QuietButton}"/></WrapPanel>
       <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="Asset for a new unit" Style="{StaticResource FieldLabel}"/>
         <ComboBox x:Name="PilotAssetBox" SelectionChanged="PilotAssetBox_SelectionChanged" AutomationProperties.Name="Asset for the new unit">
          <ComboBox.ItemTemplate>
           <DataTemplate>
            <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding AssetDisplay, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding Category, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Location, Mode=OneWay}"/></TextBlock>
           </DataTemplate>
          </ComboBox.ItemTemplate>
         </ComboBox>
         <Button x:Name="StartAddUnitButton" Content="Add unit to this asset" Click="StartAddUnit_Click" HorizontalAlignment="Left" IsEnabled="False" Margin="-4,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
         <TextBlock Text="Pilot unit" Style="{StaticResource FieldLabel}"/>
         <ComboBox x:Name="PilotUnitBox" DisplayMemberPath="AdminDisplay" SelectionChanged="PilotUnitBox_SelectionChanged" AutomationProperties.Name="Unit to use for the pilot"/>
         <Button Content="Edit this unit and photo" Click="StartEditPilot_Click" HorizontalAlignment="Left" Margin="-4,8,0,0"/>
        </StackPanel>
       </Grid>
      </StackPanel>
     </DockPanel></Border>

     <Border x:Name="PilotContentStep" Style="{StaticResource Card}" Margin="0,0,0,14"><DockPanel>
      <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" Style="{StaticResource StepNumberText}"/></Border>
      <StackPanel>
       <TextBlock Text="Give the operator something useful" Style="{StaticResource SectionTitle}"/>
       <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0" Text="Attach one approved PDF (a drawing or manual) and add one common problem with a photo and its fix. Setup copies files into the library."/>
       <TextBlock x:Name="StartContentStatus" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0"/>
       <WrapPanel Style="{StaticResource ActionRow}"><Button Content="Attach a PDF to the pilot unit…" Click="StartAttachPdf_Click"/><Button x:Name="StartProblemButton" Content="Add a common problem" Click="StartProblem_Click"/><Button Content="Add parts" Click="StartParts_Click" Style="{StaticResource QuietButton}"/></WrapPanel>
      </StackPanel>
     </DockPanel></Border>

     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><DockPanel>
      <Border Style="{StaticResource StepNumber}"><TextBlock Text="4" Style="{StaticResource StepNumberText}"/></Border>
      <StackPanel>
       <TextBlock Text="Try it as an operator" Style="{StaticResource SectionTitle}"/>
       <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0" Text="Ask a colleague to find the unit by its photo, open its document and find the fix under Common Problems. If they manage all three without help, the pilot is ready."/>
       <WrapPanel Style="{StaticResource ActionRow}"><Button x:Name="StartOperatorButton" Content="Open the pilot in operator view" Click="StartOperator_Click" Style="{StaticResource PrimaryButton}"/></WrapPanel>
      </StackPanel>
     </DockPanel></Border>

     <Border x:Name="PilotPhoneStep" Style="{StaticResource Card}"><DockPanel>
      <Border Style="{StaticResource StepNumber}"><TextBlock Text="5" Style="{StaticResource StepNumberText}"/></Border>
      <StackPanel>
       <TextBlock Text="Phone access (optional)" Style="{StaticResource SectionTitle}"/>
       <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0" Text="Use Publish &amp; print QR in the main window to publish every unit to Google Drive and print its QR label."/>
       <Expander x:Name="OfflineLabelsExpander" Header="Offline label export (older method)" Margin="-6,10,0,0">
        <StackPanel>
         <TextBlock x:Name="PilotQrStatus" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
         <WrapPanel Style="{StaticResource ActionRow}"><Button x:Name="EditPilotQrButton" Content="Edit offline QR settings" Click="StartPhoneGuides_Click"/><Button Content="Export this pilot…" Click="ExportPilotPhoneGuide_Click"/></WrapPanel>
         <TextBlock x:Name="PilotExportStatus" TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}"/>
        </StackPanel>
       </Expander>
      </StackPanel>
     </DockPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>

   <!-- UNITS & ASSETS -->
   <TabItem x:Name="UnitsSetupTab" Header="Units &amp; assets" Tag="&#xE8B7;">
    <Grid Margin="24,20,24,16">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Grid.ColumnSpan="5" Margin="0,0,0,14">
      <TextBlock Text="Units &amp; assets" Style="{StaticResource PageHeading}"/>
      <TextBlock Style="{StaticResource PageSubtitle}" Text="Pick an asset, then a unit, to edit its number, identification photo and equipment."/>
     </StackPanel>
     <Border Grid.Row="1" Style="{StaticResource ListCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="ASSETS" Style="{StaticResource ListHeading}"/>
      <ComboBox x:Name="GateAreaFilterBox" Grid.Row="1" SelectionChanged="GateAreaFilterBox_SelectionChanged" AutomationProperties.Name="Area"/>
      <ListBox x:Name="GateList" Grid.Row="2" Margin="0,8,0,0" BorderThickness="0" Padding="0" DisplayMemberPath="Display" SelectionChanged="GateList_SelectionChanged"/>
      <UniformGrid Grid.Row="3" Columns="2" Margin="-4,6,-4,-4"><Button Content="+ New asset" Click="NewGate_Click"/><Button Content="Delete" Click="DeleteGate_Click" Style="{StaticResource DangerButton}"/></UniformGrid>
     </Grid></Border>
     <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ListCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="UNITS" Style="{StaticResource ListHeading}"/>
      <ListBox x:Name="UnitListAdmin" Grid.Row="1" BorderThickness="0" Padding="0" DisplayMemberPath="UnitDisplay" SelectionChanged="UnitListAdmin_SelectionChanged"/>
      <StackPanel Grid.Row="2" Margin="-4,6,-4,-4"><Button Content="+ Unit" Click="NewUnit_Click"/><Button Content="Delete" Click="DeleteUnit_Click" Style="{StaticResource DangerButton}"/></StackPanel>
     </Grid></Border>
     <ScrollViewer x:Name="GateUnitEditorScroll" Grid.Row="1" Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <GroupBox x:Name="UnitEditorGroup" Header="Selected unit"><StackPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Unit number" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource InkMuted}"/>
        <TextBox x:Name="UnitNumberBox" Grid.Column="2" AutomationProperties.Name="Unit number"/>
       </Grid>
       <Border x:Name="UnitPhotoPreviewBorder" Margin="0,12,0,0" Padding="12" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Focusable="True" AllowDrop="True" PreviewKeyDown="UnitPhotoPreviewBorder_PreviewKeyDown" MouseLeftButtonDown="UnitPhotoPreviewBorder_MouseLeftButtonDown" DragOver="UnitPhotoPreviewBorder_DragOver" Drop="UnitPhotoPreviewBorder_Drop" ToolTip="Click here and press Ctrl+V to paste an image, or drag an image file onto it.">
        <StackPanel>
         <Border Height="250" Background="{DynamicResource Surface}" CornerRadius="8" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <Grid><Image x:Name="UnitPhotoPreview" Stretch="Uniform" Margin="4"/><TextBlock Text="{Binding Text, ElementName=UnitPhotoPreviewStatus}" TextWrapping="Wrap" TextAlignment="Center" Margin="20" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=UnitPhotoPreview}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
         </Border>
         <DockPanel Margin="0,10,0,0">
          <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top"><Button Content="Choose photo…" Click="ChoosePhoto_Click" Margin="4,0,0,0"/><Button Content="Paste image" Click="PastePhoto_Click" Margin="8,0,0,0"/></WrapPanel>
          <StackPanel>
           <TextBlock Text="Identification photo" FontWeight="SemiBold"/>
           <TextBlock Style="{StaticResource HelpText}" Text="Choose a file, paste (click the preview, then Ctrl+V) or drag an image onto it."/>
          </StackPanel>
         </DockPanel>
         <TextBlock x:Name="UnitPhotoText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource InkMuted}" Margin="0,6,0,0"/>
         <TextBlock x:Name="UnitPhotoPreviewStatus" Text="Choose, paste, or drop a photo to preview it before saving the unit." Style="{StaticResource HelpText}" Margin="0,2,0,0"/>
        </StackPanel>
       </Border>
       <TextBlock Text="Equipment on this unit" Style="{StaticResource FieldLabel}"/>
       <WrapPanel><CheckBox x:Name="UnitHasSignalColumnCheck" Content="Signal column" Margin="0,2,24,0"/><CheckBox x:Name="UnitHasScannerCheck" Content="Safety scanner" Margin="0,2,0,0"/></WrapPanel>
       <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" Text="Untick equipment the unit doesn’t have. Its files are kept; only the unit-page button is hidden."/>
       <Expander x:Name="MobileSettingsExpander" Header="Offline QR label (older method, optional)" Margin="-6,12,0,0"><StackPanel>
        <TextBlock Style="{StaticResource HelpText}" Text="Offline text works without accounts or internet. An approved document link, if filled in, takes priority over the offline text in the QR code."/>
        <TextBlock Text="Short offline instructions (700 characters maximum)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MobileOfflineBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="85" MaxLength="700" VerticalContentAlignment="Top"/>
        <TextBlock Text="Approved HTTPS document link (optional)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MobileSupportUrlBox" TextWrapping="Wrap"/>
        <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0" Text="Save the unit, then use Return to phone pilot. Clear the link to go back to offline text."/>
       </StackPanel></Expander>
       <WrapPanel Style="{StaticResource ActionRow}"><Button x:Name="SaveUnitButton" Content="Save unit" Click="SaveUnit_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Next: pilot checklist" Click="ReturnStart_Click" Style="{StaticResource QuietButton}"/><Button x:Name="ReturnPhonePilotButton" Content="Return to phone pilot" Click="ReturnPhonePilot_Click" Style="{StaticResource QuietButton}"/></WrapPanel>
      </StackPanel></GroupBox>

      <Expander x:Name="GateInformationExpander" Header="Asset details — shared by all its units" Margin="-6,0,0,0"><StackPanel Margin="0,4,6,0">
       <Border Style="{StaticResource Card}"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Area" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/><ComboBox x:Name="GateAreaBox" AutomationProperties.Name="Area"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Asset number" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/><TextBox x:Name="GateAssetBox" AutomationProperties.Name="Asset number"/></StackPanel>
        </Grid>
        <TextBlock Text="Location / description" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GateLocationBox" AutomationProperties.Name="Location"/>
        <Expander Header="Manufacturer, search terms and PLC details (optional)" Margin="-6,12,0,0"><StackPanel>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Manufacturer / system" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GateManufacturerBox"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Model" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GateModelBox"/></StackPanel>
          <StackPanel Grid.Row="1"><TextBlock Text="Equipment type" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GateTypeBox"/></StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Search keywords" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GateKeywordsBox"/></StackPanel>
          <StackPanel Grid.Row="2"><TextBlock Text="PLC address / IP" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PlcAddressBox"/></StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="PLC model" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PlcModelBox"/></StackPanel>
         </Grid>
         <TextBlock Text="PLC notes" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PlcNotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalContentAlignment="Top"/>
        </StackPanel></Expander>
        <WrapPanel Style="{StaticResource ActionRow}"><Button x:Name="SaveGateButton" Content="Save asset" Click="SaveGate_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Next: add a unit to this asset" Click="NewUnit_Click" Style="{StaticResource QuietButton}"/></WrapPanel>
       </StackPanel></Border>
      </StackPanel></Expander>
      <TextBlock Style="{StaticResource HelpText}" Margin="2,12,0,0" Text="Drawings are added from each unit’s page in the main window (Add drawing pair). One drawing can cover several units."/>
     </StackPanel></ScrollViewer>
    </Grid>
   </TabItem>

   <!-- COMMON PROBLEMS & HELP -->
   <TabItem x:Name="HelpSetupTab" Header="Common problems" Tag="&#xE897;">
    <Grid Margin="24,20,24,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
      <TextBlock Text="Common problems &amp; help" Style="{StaticResource PageHeading}"/>
      <TextBlock Style="{StaticResource PageSubtitle}" Text="Common problems appear as photo cards beside every unit. Quick help topics appear on the home page."/>
     </StackPanel>
     <Border Grid.Row="1" Style="{StaticResource ListCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="TOPICS" Style="{StaticResource ListHeading}"/>
      <ListBox x:Name="HelpList" Grid.Row="1" BorderThickness="0" Padding="0" DisplayMemberPath="AdminDisplay" SelectionChanged="HelpList_SelectionChanged"/>
      <WrapPanel Grid.Row="2" Margin="-4,6,-4,-4"><Button x:Name="NewCommonProblemButton" Content="+ Common problem" Click="NewCommonProblem_Click"/><Button Content="+ Help topic" Click="NewHelp_Click"/><Button Content="Delete" Click="DeleteHelp_Click" Style="{StaticResource DangerButton}"/></WrapPanel>
     </Grid></Border>
     <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Topic" Style="{StaticResource SectionTitle}"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Title" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HelpTitleBox"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Shown in" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="HelpSectionBox"><ComboBoxItem Content="Quick Help"/><ComboBoxItem Content="Troubleshooting"/><ComboBoxItem Content="Common Problems"/></ComboBox></StackPanel>
       </Grid>
       <TextBlock Text="How to recognise it and how to fix it" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HelpBodyBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="130" VerticalContentAlignment="Top"/>
       <TextBlock Text="Photos (optional)" Style="{StaticResource FieldLabel}"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <StackPanel>
         <ListBox x:Name="HelpPhotoList" DisplayMemberPath="Label" Height="120" SelectionChanged="HelpPhoto_SelectionChanged"/>
         <WrapPanel Margin="-4,6,0,0"><Button Content="Add photos…" Click="ChooseHelpPhoto_Click"/><Button Content="Use as cover" Click="CoverHelpPhoto_Click" Style="{StaticResource QuietButton}"/><Button Content="Remove" Click="RemoveHelpPhoto_Click" Style="{StaticResource DangerButton}"/></WrapPanel>
        </StackPanel>
        <Border Grid.Column="2" Height="160" Background="{DynamicResource SurfaceAlt}" CornerRadius="8" VerticalAlignment="Top"><Image x:Name="HelpPhotoPreview" Stretch="Uniform" Margin="4"/></Border>
       </Grid>
       <TextBlock x:Name="HelpPhotoStatus" TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}" Margin="0,4,0,0"/>
       <CheckBox x:Name="HelpVisibleCheck" Content="Show this to users" IsChecked="True" Margin="0,14,0,0"/>
       <Expander Header="Search keywords and order" Margin="-6,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Keywords" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HelpKeywordsBox"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Sort order" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HelpSortBox"/></StackPanel>
       </Grid></Expander>
       <WrapPanel Style="{StaticResource ActionRow}"><Button x:Name="SaveHelpButton" Content="Save topic" Click="SaveHelp_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Back to pilot checklist" Click="ReturnStart_Click" Style="{StaticResource QuietButton}"/></WrapPanel>
      </StackPanel></Border>
      <Expander Header="Home page wording (optional)" Margin="-6,14,0,0"><Border Style="{StaticResource Card}" Margin="6,4,6,0"><StackPanel>
       <TextBlock Text="Home subtitle" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/><TextBox x:Name="HomeSubtitleBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" VerticalContentAlignment="Top"/>
       <TextBlock Text="Manuals page introduction" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ManualsIntroBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" VerticalContentAlignment="Top"/>
