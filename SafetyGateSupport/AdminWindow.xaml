      <UniformGrid Grid.Row="2" Columns="2" Margin="-4,6,-4,-4"><Button x:Name="NewPartButton" Content="+ Part" Click="NewPart_Click"/><Button Content="Delete" Click="DeletePart_Click" Style="{StaticResource DangerButton}"/></UniformGrid>
     </Grid></Border>
     <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
       <TextBlock Text="Add or refresh a part by Item ID" Style="{StaticResource SectionTitle}"/>
       <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0" Text="Details and any supplied photo are saved to the shared library."/>
       <TextBlock Text="Stockroom" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ImportPlantBox" DisplayMemberPath="Name" MaxWidth="320" HorizontalAlignment="Stretch" AutomationProperties.Name="Stockroom plant"/>
       <TextBlock Text="Item ID" Style="{StaticResource FieldLabel}"/>
       <DockPanel MaxWidth="520" HorizontalAlignment="Stretch"><Button x:Name="ImportItemButton" Content="Import" Click="ImportItem_Click" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/><TextBox x:Name="PartNumberBox" FontSize="16" KeyDown="ImportItem_KeyDown" AutomationProperties.Name="Item ID"/></DockPanel>
       <TextBlock x:Name="ImportItemStatus" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource InkMuted}"/>
       <Expander Header="Bulk import by Item ID" Margin="-6,8,0,0"><StackPanel>
        <TextBlock Style="{StaticResource HelpText}" Text="Paste up to 100 IDs separated by lines, commas or spaces. Duplicates are skipped. Choose unit assignments afterwards."/>
        <TextBox x:Name="BulkItemIdsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,8,0,0"/>
        <Button x:Name="BulkImportButton" Content="Import these Item IDs" Click="BulkImport_Click" HorizontalAlignment="Left" Margin="-4,8,0,0"/>
       </StackPanel></Expander>
       <ListBox x:Name="ImportResultsList" MaxHeight="180" Margin="0,8,0,0"><ListBox.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap"><Run Text="{Binding ItemId, Mode=OneWay}" FontWeight="Bold"/><Run Text=" · "/><Run Text="{Binding Status, Mode=OneWay}"/></TextBlock></DataTemplate></ListBox.ItemTemplate></ListBox>
      </StackPanel></Border>

      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="Where this part is used" Style="{StaticResource SectionTitle}"/>
       <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0" Text="Leave both lists empty to show the part everywhere. An asset applies it to all of its units; pick units for exceptions."/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Assets" Style="{StaticResource FieldLabel}"/><ListBox x:Name="PartGateAssignments" Height="150" DisplayMemberPath="Display" SelectionMode="Multiple"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Specific units (optional)" Style="{StaticResource FieldLabel}"/><ListBox x:Name="PartUnitAssignments" Height="150" DisplayMemberPath="AdminDisplay" SelectionMode="Multiple"/></StackPanel>
       </Grid>
       <Expander Header="Part details (optional edits)" Margin="-6,12,0,0"><StackPanel Margin="0,0,6,0">
        <TextBlock Text="Item name" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/><TextBox x:Name="PartDescriptionBox" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
        <TextBlock Text="Stockroom description" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PartSourceDescriptionBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Bin location" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PartBinBox"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Reported quantity" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PartQuantityBox"/></StackPanel>
         <StackPanel Grid.Column="4"><TextBlock Text="Site" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PartSiteBox"/></StackPanel>
        </Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Manufacturer" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PartManufacturerBox"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Keywords" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PartKeywordsBox"/></StackPanel>
        </Grid>
        <TextBlock Text="Related assets (free text, older records)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PartAssetsBox"/>
        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PartNotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="75" VerticalContentAlignment="Top"/>
        <TextBlock Text="Document" Style="{StaticResource FieldLabel}"/><DockPanel><Button Content="Choose / replace document…" Click="ChoosePartDocument_Click" Margin="-4,0,8,0"/><TextBlock x:Name="PartDocumentText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}"/></DockPanel>
       </StackPanel></Expander>
       <WrapPanel Style="{StaticResource ActionRow}"><Button x:Name="SavePartButton" Content="Save part" Click="SavePart_Click" Style="{StaticResource PrimaryButton}"/></WrapPanel>
      </StackPanel></Border>
     </StackPanel></ScrollViewer>
    </Grid>
   </TabItem>

   <!-- LIBRARY & SOFTWARE -->
   <TabItem x:Name="LibrarySetupTab" Header="Library &amp; software" Tag="&#xE8F1;">
    <ScrollViewer Style="{StaticResource Page}"><StackPanel MaxWidth="860" HorizontalAlignment="Left">
     <TextBlock Text="Library &amp; software" Style="{StaticResource PageHeading}"/>
     <TextBlock Style="{StaticResource PageSubtitle}" Text="Where this plant’s content lives, plus maintenance tools and settings for this computer." Margin="0,4,0,20"/>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
      <TextBlock Text="Shared library location" Style="{StaticResource SectionTitle}"/>
      <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0" Text="Every PC for this plant should point at the same folder. Use Start here to connect or create one."/>
      <DockPanel Margin="0,10,0,0"><Button Content="Choose folder…" Click="ChooseSharedRoot_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="SharedRootBox" AutomationProperties.Name="Shared library folder"/></DockPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
      <TextBlock Text="Maintenance" Style="{StaticResource SectionTitle}"/>
      <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0" Text="Preview a tidy folder layout for each asset, merge identical copies and review conflicting revisions before applying. Existing files are backed up."/>
      <WrapPanel Style="{StaticResource ActionRow}"><Button x:Name="OrganizeAssetFoldersButton" Content="Organize asset folders…" Click="OrganizeAssetFolders_Click"/></WrapPanel>
      <Expander Header="Huntingdon sample data (training only)" Margin="-6,10,0,0"><StackPanel>
       <TextBlock Style="{StaticResource HelpText}" Text="Only install this if you intend to use the supplied Huntingdon equipment and parts. For another plant, use Start here → Create blank plant library."/>
       <Button Content="Install Huntingdon sample data" Click="Initialize_Click" HorizontalAlignment="Left" Margin="-4,8,0,0"/>
      </StackPanel></Expander>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
      <TextBlock Text="Stockroom" Style="{StaticResource SectionTitle}"/>
      <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0" Text="Each PC chooses its own stockroom plant on the Parts page. Nothing here needs to change for that."/>
      <Expander Header="First-time stockroom check on a new PC" Margin="-6,8,0,0">
       <TextBlock Style="{StaticResource HelpText}" Text="1. Install Microsoft Edge WebView2 Runtime if it is missing.&#10;2. Connect to the plant network and open the stockroom in a browser to confirm inventory access.&#10;3. In Parts, choose Huntingdon, Salisbury or Newport, then refresh stock.&#10;4. Compare one known Item ID and its Available quantity with the stockroom. Zero means out of stock; unknown means the lookup hasn’t been confirmed.&#10;5. If it fails, save a stockroom report from the parts panel and share it with your support contact."/>
      </Expander>
      <TextBox x:Name="StoreroomUrlBox" Visibility="Collapsed"/>
      <WrapPanel Style="{StaticResource ActionRow}"><Button Content="Save shared settings" Click="SaveSharedContent_Click"/></WrapPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
      <TextBlock Text="Vendor software on this computer (optional)" Style="{StaticResource SectionTitle}"/>
      <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0" Text="Only needed for the “open in vendor software” shortcuts. The built-in signal column tool doesn’t need these."/>
      <TextBlock Text="Siemens 8WD46 Configurator" Style="{StaticResource FieldLabel}"/><DockPanel><Button Content="Browse…" Click="BrowseSiemens_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="SiemensBox"/></DockPanel>
      <TextBlock Text="UAM Project Designer" Style="{StaticResource FieldLabel}"/><DockPanel><Button Content="Browse…" Click="BrowseUam_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="UamBox"/></DockPanel>
      <WrapPanel Style="{StaticResource ActionRow}"><Button Content="Save software paths" Click="SaveLocalSettings_Click"/></WrapPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
      <TextBlock Text="Offline phone guides (older method)" Style="{StaticResource SectionTitle}"/>
      <TextBlock Style="{StaticResource HelpText}" Margin="0,4,0,0" Text="Export printable photo guides and text-only QR labels with no server or login. For Google Drive QR folders, use Publish &amp; print QR in the main window instead."/>
      <CheckBox x:Name="ExportIncludeNotesCheck" Content="Include shared notes in the exported guides" Margin="0,10,0,0"/>
      <WrapPanel Style="{StaticResource ActionRow}"><Button x:Name="ExportPhoneGuidesButton" Content="Export phone guides and QR labels…" Click="ExportPhoneGuides_Click"/></WrapPanel>
      <TextBlock x:Name="PhoneExportStatus" TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}"/>
     </StackPanel></Border>
     <TextBlock Style="{StaticResource HelpText}" Text="Distribution: keep the published SafetyGateSupport.exe in Q:\SafetyGateSupport\Application and give users a shortcut to it. The app never updates itself."/>
    </StackPanel></ScrollViewer>
   </TabItem>

   <!-- ADVANCED: MANUALS -->
   <TabItem x:Name="ManualsSetupTab" Header="Manuals" Tag="&#xE8A5;" Visibility="Collapsed">
    <Grid Margin="24,20,24,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
