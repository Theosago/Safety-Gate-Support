     <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,14"><TextBlock Text="Resource buttons" Style="{StaticResource PageHeading}"/><TextBlock Style="{StaticResource PageSubtitle}" Text="Folders, links and managed files shown for an asset’s units. One resource can be shared by several units."/></StackPanel>
