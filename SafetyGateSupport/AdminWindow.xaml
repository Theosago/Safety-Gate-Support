       <StackPanel><TextBlock Text="Search keywords" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ResourceKeywordsBox"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Sort order" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ResourceSortBox"/></StackPanel>
      </Grid>
      <WrapPanel Style="{StaticResource ActionRow}"><Button Content="Save button" Click="SaveResource_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Open current folder" Click="OpenResourceCurrent_Click" Style="{StaticResource QuietButton}"/><Button Content="Open archive" Click="OpenResourceArchive_Click" Style="{StaticResource QuietButton}"/></WrapPanel>
     </StackPanel></Border></ScrollViewer>
    </Grid>
