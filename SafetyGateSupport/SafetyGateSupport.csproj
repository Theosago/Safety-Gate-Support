<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SafetyGateSupport</AssemblyName>
    <RootNamespace>SafetyGateSupport</RootNamespace>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Version>8.0.0</Version>
    <AssemblyVersion>8.0.0.0</AssemblyVersion>
    <FileVersion>8.0.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="SeedData.zip" />
    <Content Include="../docs/third-party/**/*" Link="ThirdPartyNotices/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <ProjectReference Include="../SafetyGateSupport.Hokuyo/SafetyGateSupport.Hokuyo.csproj" />
    <ProjectReference Include="../SafetyGateSupport.Siemens.Desktop/SafetyGateSupport.Siemens.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
  </ItemGroup>
</Project>
