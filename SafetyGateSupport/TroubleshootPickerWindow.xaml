<Window x:Class="SafetyGateSupport.TroubleshootPickerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Troubleshoot a System" Height="650" Width="1080" MinHeight="560" MinWidth="940"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock x:Name="TaskTitleText" Text="Which unit are you working on?" FontSize="26" FontWeight="Bold"/>
   <TextBlock x:Name="TaskDescriptionText" Text="Search across all areas by asset number. Choose the unit and confirm its photo before continuing." Foreground="#555" Margin="0,4,0,14" TextWrapping="Wrap"/>
  </StackPanel>

  <Grid Grid.Row="1" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ComboBox x:Name="AreaBox" Height="36" FontSize="15" SelectionChanged="AreaBox_SelectionChanged"/>
   <TextBox x:Name="AssetSearchBox" Grid.Column="2" Height="36" FontSize="15" VerticalContentAlignment="Center" TextChanged="AssetSearchBox_TextChanged" ToolTip="Search asset number or gate manufacturer / system"/>
  </Grid>

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="2*"/>
    <ColumnDefinition Width="14"/>
    <ColumnDefinition Width="1.15*"/>
    <ColumnDefinition Width="14"/>
    <ColumnDefinition Width="2.1*"/>
   </Grid.ColumnDefinitions>
   <GroupBox Header="Safety Gates">
    <ListBox x:Name="AssetList" Margin="6" SelectionChanged="AssetList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox>
   </GroupBox>
   <GroupBox Header="Units" Grid.Column="2">
    <ListBox x:Name="UnitList" Margin="6" SelectionChanged="UnitList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding UnitDisplay}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox>
   </GroupBox>
   <GroupBox Header="Selected Unit Preview" Grid.Column="4">
    <Grid Margin="10">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <TextBlock x:Name="PreviewTitleText" Text="Select a unit" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <Border Grid.Row="1" BorderBrush="#C8C8C8" BorderThickness="1" CornerRadius="3" Background="#F7F7F7" MinHeight="220">
      <Grid>
       <Image x:Name="PreviewImage" Stretch="Uniform" Margin="6"/>
       <TextBlock x:Name="PreviewPlaceholderText" Text="Choose a safety gate and unit to see its identification photo." Foreground="#777" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"/>
      </Grid>
     </Border>
     <TextBlock x:Name="PreviewDetailText" Grid.Row="2" Foreground="#444" Margin="0,10,0,0" TextWrapping="Wrap"/>
     <TextBlock x:Name="PreviewStatusText" Grid.Row="3" Foreground="#777" Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap"/>
    </Grid>
   </GroupBox>
  </Grid>

  <Grid Grid.Row="3" Margin="0,14,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="SelectedText" Text="Select a safety gate and unit." Foreground="#555" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
   <Button Grid.Column="1" Content="Cancel" Click="Cancel_Click" Padding="22,8" Margin="0,0,8,0"/>
   <Button x:Name="StartButton" Grid.Column="2" Content="Continue" Click="Start_Click" Padding="22,8" IsEnabled="False" Style="{StaticResource PrimaryButton}"/>
  </Grid>
 </Grid>
</Window>
