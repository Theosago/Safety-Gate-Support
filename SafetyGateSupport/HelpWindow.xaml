<Window x:Class="SafetyGateSupport.HelpWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Safety Gate Support - Help" Height="540" Width="820" MinHeight="430" MinWidth="680"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock x:Name="SectionText" Foreground="#1769AA" FontWeight="SemiBold" FontSize="13"/>
   <TextBlock x:Name="TitleText" FontSize="26" FontWeight="Bold" Margin="0,4,0,12" TextWrapping="Wrap"/>
  </StackPanel>
  <Border Grid.Row="1" BorderBrush="#D6DCE2" BorderThickness="1" CornerRadius="4" Background="#FAFBFC" Padding="18">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <TextBlock x:Name="BodyText" FontSize="15" LineHeight="24" TextWrapping="Wrap" Foreground="#333"/>
   </ScrollViewer>
  </Border>
  <Grid Grid.Row="2" Margin="0,14,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="This content is managed from Setup Mode and shared through Q:\SafetyGateSupport." Foreground="#777" VerticalAlignment="Center"/>
   <Button Grid.Column="1" Content="Close" Click="Close_Click" Padding="24,8"/>
  </Grid>
 </Grid>
</Window>
